# ============================================
# Telegram Bot Integration for Хвалите Quality
# ============================================

# Токен бота Telegram от @BotFather (например: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# Chat ID чата / группы / канала (или несколько через запятую: 123456789,987654321)
TELEGRAM_CHAT_ID=

# Опционально: ID темы/топика в группе с включёнными темами
# TELEGRAM_THREAD_ID=

# Опционально: порт сервера при запуске node (по умолчанию 4321)
# PORT=4321
# HOST=0.0.0.0
