---
// BookingModal.astro — Модалка бронирования записи подкаста
import { getAssetUrl } from '../utils/paths';
---

<dialog id="bookingModal" class="booking-dialog">
  <div class="booking-card">
    <div class="booking-head">
      <div class="booking-badge">ХВАЛИТЕ QUALITY</div>
      <button type="button" class="btn-close" id="closeBookingBtn" aria-label="Закрыть">✕</button>
    </div>

    <h3 class="booking-title">Забронировать запись</h3>
    <p class="booking-subtitle">
      Оставьте контакт — продюсер свяжется в течение 15 минут, подберёт дату и закрепит за вами студийное время.
    </p>

    <form class="booking-form" id="bookingForm" data-endpoint={getAssetUrl('/api/lead')}>
      <div class="form-group">
        <label for="bookName" class="form-label">Ваше имя</label>
        <input type="text" id="bookName" name="name" class="form-input" placeholder="Как вас зовут?" required />
      </div>

      <div class="form-group">
        <label for="bookPhone" class="form-label">Телефон или Telegram</label>
        <input type="text" id="bookPhone" name="contact" class="form-input" placeholder="+7 999 000-00-00 или @username" required />
      </div>

      <div class="form-group">
        <label for="bookFormat" class="form-label">Локация / Тариф</label>
        <select id="bookFormat" name="service" class="form-select">
          <option value="Под ключ (35 900 ₽)">Тариф «Под ключ» — 35 900 ₽ (ХИТ)</option>
          <option value="Старт (20 900 ₽)">Тариф «Старт» — 20 900 ₽</option>
          <option value="Контент на месяц (76 900 ₽)">Тариф «Контент на месяц» — 76 900 ₽</option>
          <option value="Корпоративный (69 900 ₽)">Тариф «Корпоративный» — 69 900 ₽</option>
          <option value="Абонемент">Абонемент (регулярная запись)</option>
          <option value="Локация Лаундж (ретро-ТВ)">Локация Лаундж (ретро-ТВ)</option>
          <option value="Локация Трансформер">Локация Трансформер (20+ сетапов)</option>
          <option value="Калькулятор">Индивидуальный расчёт из калькулятора</option>
          <option value="Консультация">Нужна консультация продюсера</option>
        </select>
      </div>

      <div class="booking-calc-preview" id="bookingCalcBox" style="display: none;">
        <div class="calc-preview-head">
          <span class="calc-preview-label">Смета из калькулятора:</span>
          <span class="calc-preview-badge" id="bookingCalcTotal"></span>
        </div>
        <pre class="calc-preview-text" id="bookingCalcText"></pre>
        <input type="hidden" name="calc_summary" id="bookingCalcHidden" value="" />
      </div>

      <label class="form-consent">
        <input type="checkbox" name="consent" required checked class="consent-checkbox" />
        <span class="consent-text">
          Согласен на <a href={getAssetUrl('/privacy/#consent')} target="_blank" rel="noopener noreferrer">обработку персональных данных</a> и с <a href={getAssetUrl('/privacy/')} target="_blank" rel="noopener noreferrer">политикой конфиденциальности</a>
        </span>
      </label>

      <button type="submit" class="btn-brutal btn-gold submit-btn">
        <span>Отправить заявку</span>
        <span>→</span>
      </button>

      <div class="form-status" id="formStatus"></div>
    </form>
  </div>
</dialog>

<style>
  .booking-dialog {
    border: none;
    background: transparent;
    padding: 16px;
    max-width: 520px;
    width: 100%;
    margin: auto;
  }
  .booking-dialog::backdrop {
    background: rgba(27, 27, 27, 0.75);
    backdrop-filter: blur(6px);
  }
  .booking-card {
    background: #FFFFFF;
    border: var(--border-dark-thick);
    border-radius: var(--radius-card-lg);
    box-shadow: 8px 8px 0px var(--color-dark);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
  }
  .booking-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .booking-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    background: var(--color-gold-bright);
    color: var(--color-dark);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-dark);
  }
  .btn-close {
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--color-dark);
    border-radius: 50%;
    background: #FFF;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s, background-color 0.2s;
  }
  .btn-close:hover {
    background: var(--color-dark);
    color: #FFF;
  }
  .booking-title {
    font-family: var(--font-accent);
    font-size: 26px;
    font-weight: 900;
    color: var(--color-dark);
    line-height: 1.2;
  }
  .booking-subtitle {
    font-size: 14px;
    color: var(--color-stone);
    line-height: 1.5;
  }
  .booking-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 8px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-dark);
    text-transform: uppercase;
  }
  .form-input, .form-select {
    width: 100%;
    padding: 12px 14px;
    border: var(--border-dark);
    border-radius: var(--radius-sm);
    font-family: var(--font-text);
    font-size: 15px;
    color: var(--color-dark);
    background: #FAF9F5;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .form-input:focus, .form-select:focus {
    border-color: var(--color-dark);
    box-shadow: 2px 2px 0px var(--color-dark);
    background: #FFF;
  }
  .submit-btn {
    width: 100%;
    padding: 15px;
    font-size: 15px;
    margin-top: 8px;
  }
  .form-status {
    font-family: var(--font-mono);
    font-size: 13px;
    text-align: center;
    display: none;
    padding: 10px;
    border-radius: 6px;
  }
  .form-status.is-success {
    display: block;
    background: #E8F5E9;
    color: #2E7D32;
    border: 1px solid #A5D6A7;
  }
  .form-status.is-error {
    display: block;
    background: #FFEBEE;
    color: #C62828;
    border: 1px solid #FFCDD2;
  }
  .booking-calc-preview {
    background: #FAF9F5;
    border: 2px solid var(--color-dark);
    border-radius: var(--radius-sm);
    padding: 12px;
    box-shadow: 2px 2px 0px var(--color-dark);
  }
  .calc-preview-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom: 1px dashed #DCDAD4;
  }
  .calc-preview-label {
    font-family: var(--font-accent);
    font-size: 11px;
    font-weight: 800;
    color: var(--color-dark);
    text-transform: uppercase;
  }
  .calc-preview-badge {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 800;
    background: var(--color-gold-bright);
    color: var(--color-dark);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-dark);
  }
  .calc-preview-text {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
    color: var(--color-stone);
    white-space: pre-wrap;
    max-height: 110px;
    overflow-y: auto;
  }
  .form-consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 12px;
    line-height: 1.45;
    color: var(--color-stone);
    cursor: pointer;
    user-select: none;
    margin-top: 4px;
  }
  .consent-checkbox {
    width: 18px;
    height: 18px;
    margin: 1px 0 0 0;
    flex-shrink: 0;
    accent-color: var(--color-gold-bright);
    cursor: pointer;
  }
  .consent-text a {
    color: var(--color-dark);
    font-weight: 700;
    text-decoration: underline;
  }
  .consent-text a:hover {
    color: var(--color-gold-bright);
  }
</style>

<script>
  const modal = document.getElementById('bookingModal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('closeBookingBtn');
  const openBtns = document.querySelectorAll('[data-open-booking]');
  const selectEl = document.getElementById('bookFormat') as HTMLSelectElement | null;
  const form = document.getElementById('bookingForm') as HTMLFormElement | null;
  const statusEl = document.getElementById('formStatus');
  const calcBox = document.getElementById('bookingCalcBox');
  const calcText = document.getElementById('bookingCalcText');
  const calcTotal = document.getElementById('bookingCalcTotal');
  const calcHidden = document.getElementById('bookingCalcHidden') as HTMLInputElement | null;

  openBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const serviceName = btn.getAttribute('data-service-name');
      const calcSummary = btn.getAttribute('data-calc-summary');
      const calcTotalVal = btn.getAttribute('data-calc-total');

      if (calcSummary && calcBox && calcText && calcTotal && calcHidden) {
        calcBox.style.display = 'block';
        calcText.textContent = calcSummary;
        calcTotal.textContent = calcTotalVal || '';
        calcHidden.value = calcSummary;
        if (selectEl) {
          selectEl.value = 'Калькулятор';
        }
      } else if (calcBox) {
        calcBox.style.display = 'none';
        if (calcHidden) calcHidden.value = '';
        if (serviceName && selectEl) {
          for (let i = 0; i < selectEl.options.length; i++) {
            if (selectEl.options[i].text.includes(serviceName)) {
              selectEl.selectedIndex = i;
              break;
            }
          }
        }
      }

      modal?.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  function getAnalyticsData(): Record<string, string> {
    const params = new URLSearchParams(window.location.search);
    const utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'yclid', 'gclid', 'vkclid'];
    let storedUtm: Record<string, string> = {};
    try {
      storedUtm = JSON.parse(sessionStorage.getItem('xq_utm') || '{}');
    } catch {}

    let hasNewUtm = false;
    utmKeys.forEach((k) => {
      const val = params.get(k);
      if (val) {
        storedUtm[k] = val;
        hasNewUtm = true;
      }
    });
    if (hasNewUtm) {
      try { sessionStorage.setItem('xq_utm', JSON.stringify(storedUtm)); } catch {}
    }

    let landingPage = '';
    let referrer = '';
    try {
      landingPage = sessionStorage.getItem('xq_landing') || window.location.href;
      if (!sessionStorage.getItem('xq_landing')) {
        sessionStorage.setItem('xq_landing', landingPage);
      }
      referrer = sessionStorage.getItem('xq_referrer') || document.referrer || '';
      if (!sessionStorage.getItem('xq_referrer') && document.referrer) {
        sessionStorage.setItem('xq_referrer', referrer);
      }
    } catch {}

    let sessionStart = Date.now();
    try {
      const storedStart = sessionStorage.getItem('xq_session_start');
      if (storedStart) {
        sessionStart = Number(storedStart);
      } else {
        sessionStorage.setItem('xq_session_start', String(sessionStart));
      }
    } catch {}
    const secondsOnSite = Math.max(0, Math.round((Date.now() - sessionStart) / 1000));
    const timeOnSite = secondsOnSite < 60 ? `${secondsOnSite} сек.` : `${Math.floor(secondsOnSite / 60)} мин. ${secondsOnSite % 60} сек.`;

    const ua = navigator.userAgent || '';
    const isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(ua);
    const deviceType = isMobile ? 'Смартфон' : 'Десктоп';
    const screen = window.screen ? `${window.screen.width}×${window.screen.height}` : '';

    let ymUid = '';
    const ymMatch = document.cookie.match(/_ym_uid=([^;]+)/);
    if (ymMatch) ymUid = ymMatch[1];

    const result: Record<string, string> = {
      landing_page: landingPage,
      referrer: referrer || 'Прямой заход',
      device: deviceType + (screen ? ` (${screen})` : ''),
      time_on_site: timeOnSite,
      ym_uid: ymUid,
    };
    Object.keys(storedUtm).forEach((k) => { result[k] = storedUtm[k]; });
    return result;
  }

  try { getAnalyticsData(); } catch {}

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('.submit-btn') as HTMLButtonElement | null;
    const originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';
    const endpoint = form.getAttribute('data-endpoint') || '/api/lead';

    const formData = new FormData(form);
    const data: Record<string, any> = {};
    formData.forEach((val, key) => {
      data[key] = val;
    });
    data.page = window.location.href;
    try {
      Object.assign(data, getAnalyticsData());
    } catch {}

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Отправка…</span>';
    }

    if (statusEl) {
      statusEl.className = 'form-status';
      statusEl.textContent = '';
    }

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const resData = await res.json().catch(() => ({}));

      if (!res.ok || !resData.ok) {
        throw new Error(resData.error || `HTTP ${res.status}`);
      }

      if (statusEl) {
        statusEl.className = 'form-status is-success';
        statusEl.textContent = '✓ Заявка принята! Продюсер свяжется с вами в течение 15 минут.';
      }

      form.reset();
      if (calcBox) calcBox.style.display = 'none';

      setTimeout(() => {
        modal?.close();
        if (statusEl) statusEl.className = 'form-status';
      }, 2500);
    } catch (err: any) {
      console.error('Booking form error:', err);
      if (statusEl) {
        statusEl.className = 'form-status is-error';
        statusEl.textContent = err?.message || 'Не удалось отправить заявку. Попробуйте ещё раз.';
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
      }
    }
  });
</script>
