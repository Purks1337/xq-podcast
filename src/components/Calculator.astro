    cameras: number;
    hours: number;
    rentalTime: string;
    editing: string;
    rawMinutes: number;
    reels: number;
    reelsCover: number;
    videoCover: number;
    teaser: number;
    makeup: number;
    backstage: number;
    prompter: boolean;
    transcription: boolean;
    host: boolean;
    publishing: string;
    intro2d: number;
    intro3d: number;
  }

  // Данные расчёта из листа «Прайс»
  const PRICING: PricingTable = {
    studio: {
      1: { 1: 5000, 2: 9500, 3: 13500, 4: 17500 },
      2: { 1: 6000, 2: 11500, 3: 16500, 4: 21500 },
      3: { 1: 7000, 2: 13500, 3: 19500, 4: 25000 },
      4: { 1: 8000, 2: 15500, 3: 22500, 4: 29500 },
      5: { 1: 9000, 2: 18000, 3: 25500, 4: 33500 }
    },
    field: {
      1: { 1: 5000, 2: 9500, 3: 13500, 4: 17500 },
      2: { 1: 6000, 2: 11500, 3: 16500, 4: 21500 },
      3: { 1: 7000, 2: 13500, 3: 19500, 4: 25000 },
      4: { 1: 8000, 2: 15500, 3: 22500, 4: 29500 },
      5: { 1: 9000, 2: 18000, 3: 25500, 4: 33500 }
    },
    fieldDelivery: 12000,
    audio: {
      1: 2000,
      2: 4000,
      3: 6000,
      4: 8000
    },
    stream: {
      1: { 1: 8000, 2: 13500, 3: 17500, 4: 21500, 8: 37500, 10: 45500 },
      2: { 1: 11000, 2: 17000, 3: 22000, 4: 27000, 8: 47000, 10: 57000 },
      3: { 1: 14000, 2: 20000, 3: 26000, 4: 32000, 8: 56000, 10: 68000 },
      4: { 1: 17000, 2: 23000, 3: 30000, 4: 37000, 8: 65000, 10: 79000 }
    },
    rental: {
      '1 час': 2300,
      '1,5 часа': 3450,
      '2 часа': 4600,
      '2,5 часа': 5500,
      '3 часа': 6450,
      '3,5 часа': 7400,
      '4 часа': 8300,
      '4,5 часа': 9200,
      '5 часов': 10150,
      '5,5 часов': 11100,
      '6 часов': 12000,
      '6,5 часов': 12900,
      '7 часов': 13850,
      'Смена (12 часов)': 14700
    },
    editing: {
      simple: { 1: 10000, 23: 15000, 45: 20000 },
      complex: { 1: 25000, 23: 35000, 45: 43000 },
      extraPer30Min: 5000
    },
    addons: {
      reels: 1500,
      reelsCover: 1000,
      videoCover: 1800,
      teaser: 2000,
      publishingFirst: 4000,
      publishingNext: 1000,
      transcription: 4200,
      prompter: 800,
      host: 10000,
      makeup: 1700,
      intro2d: 1000,
      intro3d: 2000,
      backstage: 2500
    }
  };

  // Дефолтное состояние калькулятора (из листа «Как сбросить»)
  const DEFAULT_STATE: CalculatorState = {
    service: 'studio',      // 'studio' | 'field' | 'audio' | 'stream' | 'rental'
    cameras: 2,             // 1..5
    hours: 2,               // 1..4, 8, 10
    rentalTime: '2 часа',
    editing: 'none',        // 'none' | 'simple' | 'complex'
    rawMinutes: 60,
    reels: 0,
    reelsCover: 0,
    videoCover: 0,
    teaser: 0,
    makeup: 0,
    backstage: 0,
    prompter: false,
    transcription: false,
    host: false,
    publishing: 'none',     // 'none' | 'first' | 'next'
    intro2d: 0,             // 0, 5, 10, 15, 20, 30
    intro3d: 0              // 0, 5, 10, 15, 20, 30
  };

  let state: CalculatorState = { ...DEFAULT_STATE };

  // DOM элементы
  const serviceCards = document.querySelectorAll('.service-card');
  const camerasRow = document.getElementById('camerasRow');
  const camerasChips = document.querySelectorAll('#camerasChips .chip-btn');
  const cameraBadge = document.getElementById('cameraBadge');
  const hoursRow = document.getElementById('hoursRow');
  const hoursChips = document.querySelectorAll('#hoursChips .chip-btn');
  const hoursBadge = document.getElementById('hoursBadge');
  const streamOnlyHours = document.querySelectorAll('.stream-only');
  const rentalRow = document.getElementById('rentalRow');
  const rentalSelect = document.getElementById('rentalSelect') as HTMLSelectElement | null;
  const rentalBadge = document.getElementById('rentalBadge');
  const deliveryNotice = document.getElementById('deliveryNotice');
  const blockEditing = document.getElementById('blockEditing');
  const editOptions = document.querySelectorAll('.edit-option');
  const rawFootageWrap = document.getElementById('rawFootageWrap');
  const rawMinutesChips = document.querySelectorAll('#rawMinutesChips .chip-btn');
  const rawBadge = document.getElementById('rawBadge');
  const simpleEditPreview = document.getElementById('simpleEditPricePreview');
  const complexEditPreview = document.getElementById('complexEditPricePreview');

  // Допы
  const counterBtns = document.querySelectorAll('.counter-btn');
  const togglePrompter = document.getElementById('togglePrompter') as HTMLInputElement | null;
  const toggleTranscription = document.getElementById('toggleTranscription') as HTMLInputElement | null;
  const toggleHost = document.getElementById('toggleHost') as HTMLInputElement | null;
  const publishingSelect = document.getElementById('publishingSelect') as HTMLSelectElement | null;
  const intro2dSelect = document.getElementById('intro2dSelect') as HTMLSelectElement | null;
  const intro3dSelect = document.getElementById('intro3dSelect') as HTMLSelectElement | null;

  // Смета
  const receiptItemsList = document.getElementById('receiptItemsList');
  const finalTotalVal = document.getElementById('finalTotalVal');
  const resetCalcBtn = document.getElementById('resetCalcBtn');
  const bookCalcBtn = document.getElementById('bookCalcBtn');
  const copyCalcBtn = document.getElementById('copyCalcBtn');

  function fmtPrice(num: number) {
    return num.toLocaleString('ru-RU') + ' ₽';
  }

  function pluralCam(n: number) {
    if (n === 1) return 'камера';
    if (n >= 2 && n <= 4) return 'камеры';
    return 'камер';
  }

  function pluralHour(n: number) {
    if (n === 1) return 'час';
    if (n >= 2 && n <= 4) return 'часа';
    return 'часов';
  }

  function pluralImages(n: number) {
    if (n === 1) return 'образ';
    if (n >= 2 && n <= 4) return 'образа';
    return 'образов';
  }

  function updateUIControls() {
    // 1. Формат услуги
    serviceCards.forEach((btn) => {
      const s = btn.getAttribute('data-service');
      btn.classList.toggle('is-active', s === state.service);
    });

    // 2. Видимость блоков в зависимости от формата
    const isRental = state.service === 'rental';
    const isAudio = state.service === 'audio';
    const isStream = state.service === 'stream';
    const isField = state.service === 'field';

    if (camerasRow) {
      camerasRow.style.display = (isRental || isAudio) ? 'none' : 'block';
    }
    if (hoursRow) {
      hoursRow.style.display = isRental ? 'none' : 'block';
    }
    if (rentalRow) {
      rentalRow.style.display = isRental ? 'block' : 'none';
    }
    if (deliveryNotice) {
      deliveryNotice.style.display = isField ? 'flex' : 'none';
    }
    if (blockEditing) {
      blockEditing.style.display = (isRental || isAudio) ? 'none' : 'block';
    }

    // Лимиты камер для стрима (макс 4 камеры)
    const cam5Btn = document.querySelector('#camerasChips [data-cam="5"]') as HTMLElement | null;
    if (cam5Btn) {
      cam5Btn.style.display = isStream ? 'none' : 'inline-block';
      if (isStream && state.cameras === 5) {
        state.cameras = 4;
      }
    }

    // Часы для стрима (8 и 10 часов)
    streamOnlyHours.forEach((el) => {
      (el as HTMLElement).style.display = isStream ? 'inline-block' : 'none';
    });
    if (!isStream && (state.hours === 8 || state.hours === 10)) {
      state.hours = 4;
    }

    // Активные чипсы камер
    camerasChips.forEach((btn) => {
      const c = Number(btn.getAttribute('data-cam'));
      btn.classList.toggle('is-active', c === state.cameras);
    });
    if (cameraBadge) {
      cameraBadge.textContent = `${state.cameras} ${pluralCam(state.cameras)} (4K)`;
    }

    // Активные чипсы часов
    hoursChips.forEach((btn) => {
      const h = Number(btn.getAttribute('data-hours'));
      btn.classList.toggle('is-active', h === state.hours);
    });
    if (hoursBadge) {
      hoursBadge.textContent = `${state.hours} ${pluralHour(state.hours)}`;
    }

    // Аренда селект
    if (rentalSelect) {
      rentalSelect.value = state.rentalTime;
      if (rentalBadge) rentalBadge.textContent = state.rentalTime;
    }

    // Монтаж
    editOptions.forEach((btn) => {
      const mode = btn.getAttribute('data-editing');
      btn.classList.toggle('is-active', mode === state.editing);
    });
    if (rawFootageWrap) {
      rawFootageWrap.style.display = state.editing !== 'none' ? 'block' : 'none';
    }
    rawMinutesChips.forEach((btn) => {
      const m = Number(btn.getAttribute('data-minutes'));
      btn.classList.toggle('is-active', m === state.rawMinutes);
    });
    if (rawBadge) {
      rawBadge.textContent = `${state.rawMinutes} минут`;
    }

    // Превью цен монтажа по текущему кол-ву камер
    const camGroup = state.cameras === 1 ? 1 : (state.cameras <= 3 ? 23 : 45);
    if (simpleEditPreview) {
      simpleEditPreview.textContent = fmtPrice(PRICING.editing.simple[camGroup]);
    }
    if (complexEditPreview) {
      complexEditPreview.textContent = fmtPrice(PRICING.editing.complex[camGroup]);
    }

    // Счетчики
    const reelsVal = document.getElementById('reelsVal');
    if (reelsVal) reelsVal.textContent = String(state.reels);
    const reelsCoverVal = document.getElementById('reelsCoverVal');
    if (reelsCoverVal) reelsCoverVal.textContent = String(state.reelsCover);
    const videoCoverVal = document.getElementById('videoCoverVal');
    if (videoCoverVal) videoCoverVal.textContent = String(state.videoCover);
    const teaserVal = document.getElementById('teaserVal');
    if (teaserVal) teaserVal.textContent = String(state.teaser);
    const makeupVal = document.getElementById('makeupVal');
    if (makeupVal) makeupVal.textContent = String(state.makeup);
    const backstageVal = document.getElementById('backstageVal');
    if (backstageVal) backstageVal.textContent = String(state.backstage);

    // Тогглы
    if (togglePrompter) togglePrompter.checked = state.prompter;
    if (toggleTranscription) toggleTranscription.checked = state.transcription;
    if (toggleHost) toggleHost.checked = state.host;

    // Селекты
    if (publishingSelect) publishingSelect.value = state.publishing;
    if (intro2dSelect) intro2dSelect.value = String(state.intro2d);
    if (intro3dSelect) intro3dSelect.value = String(state.intro3d);
  }

  function calculate() {
    let basePrice = 0;
    let deliveryPrice = 0;
    let editingPrice = 0;
    const items: { name: string; price: number }[] = [];

    // 1. Основная услуга
    if (state.service === 'studio') {
      basePrice = PRICING.studio[state.cameras]?.[state.hours] || 0;
      items.push({
        name: `Видеоподкаст в студии (${state.cameras} ${pluralCam(state.cameras)}, ${state.hours} ${pluralHour(state.hours)})`,
        price: basePrice
      });
    } else if (state.service === 'field') {
      basePrice = PRICING.field[state.cameras]?.[state.hours] || 0;
      items.push({
        name: `Видеоподкаст на выезде (${state.cameras} ${pluralCam(state.cameras)}, ${state.hours} ${pluralHour(state.hours)})`,
        price: basePrice
      });
      deliveryPrice = PRICING.fieldDelivery;
      items.push({
        name: 'Доставка и монтаж техники на выезде',
        price: deliveryPrice
      });
    } else if (state.service === 'audio') {
      basePrice = PRICING.audio[state.hours] || 0;
      items.push({
        name: `Аудиоподкаст в студии (${state.hours} ${pluralHour(state.hours)})`,
        price: basePrice
      });
    } else if (state.service === 'stream') {
      basePrice = PRICING.stream[state.cameras]?.[state.hours] || 0;
      items.push({
        name: `Прямая трансляция (${state.cameras} ${pluralCam(state.cameras)}, ${state.hours} ${pluralHour(state.hours)})`,
        price: basePrice
      });
    } else if (state.service === 'rental') {
      basePrice = PRICING.rental[state.rentalTime] || 0;
      items.push({
        name: `Аренда студии без оператора (${state.rentalTime})`,
        price: basePrice
      });
    }

    // 2. Монтаж (только для видео и стрима)
    if (['studio', 'field', 'stream'].includes(state.service) && state.editing !== 'none') {
      const camGroup = state.cameras === 1 ? 1 : (state.cameras <= 3 ? 23 : 45);
      const baseEdit = state.editing === 'simple'
        ? PRICING.editing.simple[camGroup]
        : PRICING.editing.complex[camGroup];

      const extraSteps = Math.max(0, Math.ceil((state.rawMinutes - 60) / 30));
      const extraCost = extraSteps * PRICING.editing.extraPer30Min;
      editingPrice = baseEdit + extraCost;

      const editTitle = state.editing === 'simple' ? 'Простой монтаж' : 'Сложный монтаж с графикой';
      items.push({
        name: `${editTitle} (${state.rawMinutes} мин исходника)`,
        price: editingPrice
      });
    }

    // 3. Дополнительные опции
    let addonsSum = 0;
    if (state.reels > 0) {
      const cost = state.reels * PRICING.addons.reels;
      items.push({ name: `Нарезки Reels / Shorts (${state.reels} шт)`, price: cost });
      addonsSum += cost;
    }
    if (state.reelsCover > 0) {
      const cost = state.reelsCover * PRICING.addons.reelsCover;
      items.push({ name: `Обложки для Reels (${state.reelsCover} шт)`, price: cost });
      addonsSum += cost;
    }
    if (state.videoCover > 0) {
      const cost = state.videoCover * PRICING.addons.videoCover;
      items.push({ name: `Обложка выпуска YouTube (${state.videoCover} шт)`, price: cost });
      addonsSum += cost;
    }
    if (state.teaser > 0) {
      const cost = state.teaser * PRICING.addons.teaser;
      items.push({ name: `Видеотизер выпуска (${state.teaser} шт)`, price: cost });
      addonsSum += cost;
    }
    if (state.publishing === 'first') {
      items.push({ name: 'Публикация на площадках (1-й выпуск)', price: PRICING.addons.publishingFirst });
      addonsSum += PRICING.addons.publishingFirst;
    } else if (state.publishing === 'next') {
      items.push({ name: 'Публикация на площадках (след. выпуск)', price: PRICING.addons.publishingNext });
      addonsSum += PRICING.addons.publishingNext;
    }
    if (state.transcription) {
      items.push({ name: 'Расшифровка выпуска в текст', price: PRICING.addons.transcription });
      addonsSum += PRICING.addons.transcription;
    }
    if (state.prompter) {
      items.push({ name: 'Телесуфлёр на запись', price: PRICING.addons.prompter });
      addonsSum += PRICING.addons.prompter;
    }
    if (state.host) {
      items.push({ name: 'Профессиональный ведущий (2 ч)', price: PRICING.addons.host });
      addonsSum += PRICING.addons.host;
    }
    if (state.makeup > 0) {
      const cost = state.makeup * PRICING.addons.makeup;
      items.push({ name: `Гримёр (${state.makeup} ${pluralImages(state.makeup)})`, price: cost });
      addonsSum += cost;
    }
    if (state.intro2d > 0) {
      const cost = state.intro2d * PRICING.addons.intro2d;
      items.push({ name: `Интро 2D-анимация (${state.intro2d} сек)`, price: cost });
      addonsSum += cost;
    }
    if (state.intro3d > 0) {
      const cost = state.intro3d * PRICING.addons.intro3d;
      items.push({ name: `Интро 3D-графика (${state.intro3d} сек)`, price: cost });
      addonsSum += cost;
    }
    if (state.backstage > 0) {
      const cost = state.backstage * PRICING.addons.backstage;
      items.push({ name: `Фото/видео бэкстейдж (${state.backstage} шт)`, price: cost });
      addonsSum += cost;
    }

    // Итого к оплате
    const finalTotal = basePrice + deliveryPrice + editingPrice + addonsSum;

    // Рендер позиций сметы
    if (receiptItemsList) {
      receiptItemsList.innerHTML = items.map((it) => `
        <div class="receipt-line">
          <span class="receipt-line-name">• ${it.name}</span>
          <span class="receipt-line-price">${fmtPrice(it.price)}</span>
        </div>
      `).join('');
    }

    if (finalTotalVal) {
      finalTotalVal.textContent = fmtPrice(finalTotal);
    }

    // Сохраняем текстовое описание для модалки и копирования
    const summaryText = items.map(i => `• ${i.name}: ${fmtPrice(i.price)}`).join('\n')
      + `\n------------------------`
      + `\nИТОГО: ${fmtPrice(finalTotal)}`;

    if (bookCalcBtn) {
      bookCalcBtn.setAttribute('data-calc-summary', summaryText);
      bookCalcBtn.setAttribute('data-calc-total', fmtPrice(finalTotal));
      bookCalcBtn.setAttribute('data-service-name', `Расчёт из калькулятора (${fmtPrice(finalTotal)})`);
    }

    return { finalTotal, items, summaryText };
  }

  // ОБРАБОТЧИКИ СОБЫТИЙ

  // 1. Формат
  serviceCards.forEach((btn) => {
    btn.addEventListener('click', () => {
      const s = btn.getAttribute('data-service');
      if (s) {
        state.service = s;
        updateUIControls();
        calculate();
      }
    });
  });

  // 2. Камеры
  camerasChips.forEach((btn) => {
    btn.addEventListener('click', () => {
      const c = Number(btn.getAttribute('data-cam'));
      if (c) {
        state.cameras = c;
        updateUIControls();
        calculate();
      }
    });
  });

  // 3. Часы
  hoursChips.forEach((btn) => {
    btn.addEventListener('click', () => {
      const h = Number(btn.getAttribute('data-hours'));
      if (h) {
        state.hours = h;
        updateUIControls();
        calculate();
      }
    });
  });

  // 4. Аренда
  rentalSelect?.addEventListener('change', (e) => {
    state.rentalTime = (e.target as HTMLSelectElement).value;
    updateUIControls();
    calculate();
  });

  // 5. Монтаж
  editOptions.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-editing');
      if (mode) {
        state.editing = mode;
        updateUIControls();
        calculate();
      }
    });
  });

  // 6. Хронометраж
  rawMinutesChips.forEach((btn) => {
    btn.addEventListener('click', () => {
      const m = Number(btn.getAttribute('data-minutes'));
      if (m) {
        state.rawMinutes = m;
        updateUIControls();
        calculate();
      }
    });
  });

  // 7. Счетчики
  counterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const counterKey = btn.getAttribute('data-counter') as keyof typeof state;
      const dir = Number(btn.getAttribute('data-dir')) || 0;
      if (counterKey && typeof state[counterKey] === 'number') {
        const current = (state[counterKey] as number);
        const next = Math.max(0, Math.min(30, current + dir));
        (state[counterKey] as number) = next;
        updateUIControls();
        calculate();
      }
    });
  });

  // 8. Тогглы
  togglePrompter?.addEventListener('change', (e) => {
    state.prompter = (e.target as HTMLInputElement).checked;
    calculate();
  });
  toggleTranscription?.addEventListener('change', (e) => {
    state.transcription = (e.target as HTMLInputElement).checked;
    calculate();
  });
  toggleHost?.addEventListener('change', (e) => {
    state.host = (e.target as HTMLInputElement).checked;
    calculate();
  });

  // 9. Селекты
  publishingSelect?.addEventListener('change', (e) => {
    state.publishing = (e.target as HTMLSelectElement).value;
    calculate();
  });
  intro2dSelect?.addEventListener('change', (e) => {
    state.intro2d = Number((e.target as HTMLSelectElement).value);
    calculate();
  });
  intro3dSelect?.addEventListener('change', (e) => {
    state.intro3d = Number((e.target as HTMLSelectElement).value);
    calculate();
  });

  // 10. Кнопка «Сбросить»
  resetCalcBtn?.addEventListener('click', () => {
    state = { ...DEFAULT_STATE };
    updateUIControls();
    calculate();
  });

  // 11. Кнопка «Скопировать смету текстом»
  copyCalcBtn?.addEventListener('click', async () => {
    const res = calculate();
    const textToCopy = `ХВАЛИТЕ QUALITY — Расчёт сметы подкаста:\n\n${res.summaryText}\n\nЗабронировать: +7 992 341-05-20 | Екатеринбург, Ботаническая 19`;
    try {
      await navigator.clipboard.writeText(textToCopy);
      copyCalcBtn.classList.add('is-copied');
      const label = copyCalcBtn.querySelector('.copy-text');
      if (label) label.textContent = '✓ Смета скопирована!';
      setTimeout(() => {
        copyCalcBtn.classList.remove('is-copied');
        if (label) label.textContent = 'Скопировать смету текстом';
      }, 2500);
    } catch {
      alert('Не удалось скопировать в буфер обмена');
    }
  });

  // Инициализация при загрузке
  updateUIControls();
  calculate();
</script>
