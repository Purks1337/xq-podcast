---
// Calculator.astro — Интерактивный калькулятор студии подкастов ХВАЛИТЕ QUALITY
// Рассчитан точно по формулам и тарифам из Google Sheets / Excel листа «Прайс»
---

<section class="calc-section" id="calculator">
  <div class="container">
    <div class="section-head">
      <div class="section-tag">
        <span>03.1 · ОНЛАЙН-КАЛЬКУЛЯТОР</span>
        <span class="tag-star">★</span>
      </div>
      <h2 class="section-title">Калькулятор стоимости</h2>
      <p class="section-subtitle">
        Соберите индивидуальную конфигурацию под вашу задачу: от аренды студии до сложного видеопродакшна под ключ.
      </p>
    </div>

    <div class="calc-layout">
      <!-- ЛЕВАЯ КОЛОНКА: ПАРАМЕТРЫ ЗАКАЗА -->
      <div class="calc-controls">
        
        <!-- 1. Что снимаем (Формат) -->
        <div class="control-block">
          <div class="block-header">
            <span class="block-num">01</span>
            <label class="block-title">Формат записи</label>
          </div>
          <div class="service-cards" role="radiogroup" aria-label="Формат записи">
            <button type="button" class="service-card is-active" data-service="studio">
              <span class="service-icon">🎙️</span>
              <span class="service-name">Видеоподкаст в студии</span>
              <span class="service-hint">Студия + свет + звук + операторы</span>
            </button>
            <button type="button" class="service-card" data-service="field">
              <span class="service-icon">🚗</span>
              <span class="service-name">Видеоподкаст на выезде</span>
              <span class="service-hint">Съёмка в вашем офисе или локации</span>
            </button>
            <button type="button" class="service-card" data-service="audio">
              <span class="service-icon">🎧</span>
              <span class="service-name">Аудиоподкаст</span>
              <span class="service-hint">Студийный звук, без видеокамер</span>
            </button>
            <button type="button" class="service-card" data-service="stream">
              <span class="service-icon">📡</span>
              <span class="service-name">Трансляция в студии</span>
              <span class="service-hint">Прямой эфир, режиссёр и тех. спец</span>
            </button>
            <button type="button" class="service-card" data-service="rental">
              <span class="service-icon">⏱️</span>
              <span class="service-name">Аренда без оператора</span>
              <span class="service-hint">Только локация со всем оборудованием</span>
            </button>
          </div>
        </div>

        <!-- 2. Базовые параметры (Камеры / Часы / Локация) -->
        <div class="control-block" id="blockBaseParams">
          <div class="block-header">
            <span class="block-num">02</span>
            <label class="block-title">Базовые параметры</label>
          </div>

          <!-- Секция камер (для видео и стримов) -->
          <div class="param-row" id="camerasRow">
            <div class="param-label-group">
              <span class="param-label">Количество камер:</span>
              <span class="param-value-badge" id="cameraBadge">2 камеры (4K)</span>
            </div>
            <div class="chips-group" id="camerasChips">
              <button type="button" class="chip-btn" data-cam="1">1 камера</button>
              <button type="button" class="chip-btn is-active" data-cam="2">2 камеры</button>
              <button type="button" class="chip-btn" data-cam="3">3 камеры</button>
              <button type="button" class="chip-btn" data-cam="4">4 камеры</button>
              <button type="button" class="chip-btn" data-cam="5">5 камер</button>
            </div>
          </div>

          <!-- Секция времени записи -->
          <div class="param-row" id="hoursRow">
            <div class="param-label-group">
              <span class="param-label">Время записи:</span>
              <span class="param-value-badge" id="hoursBadge">2 часа</span>
            </div>
            <div class="chips-group" id="hoursChips">
              <button type="button" class="chip-btn" data-hours="1">1 час</button>
              <button type="button" class="chip-btn is-active" data-hours="2">2 часа</button>
              <button type="button" class="chip-btn" data-hours="3">3 часа</button>
              <button type="button" class="chip-btn" data-hours="4">4 часа</button>
              <button type="button" class="chip-btn stream-only" data-hours="8" style="display: none;">8 часов</button>
              <button type="button" class="chip-btn stream-only" data-hours="10" style="display: none;">10 часов</button>
            </div>
          </div>

          <!-- Секция аренды без оператора -->
          <div class="param-row" id="rentalRow" style="display: none;">
            <div class="param-label-group">
              <span class="param-label">Длительность аренды локации:</span>
              <span class="param-value-badge" id="rentalBadge">2 часа</span>
            </div>
            <div class="custom-select-wrap">
              <select id="rentalSelect" class="form-select-styled">
                <option value="1 час">1 час — 2 300 ₽</option>
                <option value="1,5 часа">1,5 часа — 3 450 ₽</option>
                <option value="2 часа" selected>2 часа — 4 600 ₽</option>
                <option value="2,5 часа">2,5 часа — 5 500 ₽</option>
                <option value="3 часа">3 часа — 6 450 ₽</option>
                <option value="3,5 часа">3,5 часа — 7 400 ₽</option>
                <option value="4 часа">4 часа — 8 300 ₽</option>
                <option value="4,5 часа">4,5 часа — 9 200 ₽</option>
                <option value="5 часов">5 часов — 10 150 ₽</option>
                <option value="5,5 часов">5,5 часов — 11 100 ₽</option>
                <option value="6 часов">6 часов — 12 000 ₽</option>
                <option value="6,5 часов">6,5 часов — 12 900 ₽</option>
                <option value="7 часов">7 часов — 13 850 ₽</option>
                <option value="Смена (12 часов)">Смена (12 часов) — 14 700 ₽ (−47%)</option>
              </select>
            </div>
          </div>

          <!-- Баннер выездной логистики -->
          <div class="delivery-notice" id="deliveryNotice" style="display: none;">
            <span class="notice-icon">📦</span>
            <div class="notice-text">
              <strong>Доставка техники на выезд:</strong> включает погрузку, доставку оборудования по Екатеринбургу и монтаж сетапа (+12 000 ₽).
            </div>
          </div>
        </div>

        <!-- 3. Монтаж выпуска (Постпродакшн) -->
        <div class="control-block" id="blockEditing">
          <div class="block-header">
            <span class="block-num">03</span>
            <label class="block-title">Монтаж выпуска</label>
            <span class="block-subtag">Постпродакшн</span>
          </div>

          <div class="editing-options">
            <button type="button" class="edit-option is-active" data-editing="none">
              <span class="edit-radio"></span>
              <div class="edit-info">
                <span class="edit-title">Без монтажа</span>
                <span class="edit-desc">Отдадим исходники в 4K и чистые аудиодорожки сразу после съёмки</span>
              </div>
              <span class="edit-price">0 ₽</span>
            </button>

            <button type="button" class="edit-option" data-editing="simple">
              <span class="edit-radio"></span>
              <div class="edit-info">
                <span class="edit-title">Простой монтаж</span>
                <span class="edit-desc">Склейка планов, сведение звука, цветокоррекция, вырезание пауз</span>
              </div>
              <span class="edit-price" id="simpleEditPricePreview">от 10 000 ₽</span>
            </button>

            <button type="button" class="edit-option" data-editing="complex">
              <span class="edit-radio"></span>
              <div class="edit-info">
                <span class="edit-title">Сложный монтаж с графикой</span>
                <span class="edit-desc">Склейка + анимационные титры, инфографика, перебивки, саунд-дизайн</span>
              </div>
              <span class="edit-price" id="complexEditPricePreview">от 25 000 ₽</span>
            </button>
          </div>

          <!-- Выбор длины исходника при включенном монтаже -->
          <div class="raw-footage-wrap" id="rawFootageWrap" style="display: none;">
            <div class="param-label-group">
              <span class="param-label">Хронометраж исходного материала:</span>
              <span class="param-value-badge" id="rawBadge">60 минут</span>
            </div>
            <div class="chips-group" id="rawMinutesChips">
              <button type="button" class="chip-btn is-active" data-minutes="60">до 60 мин (база)</button>
              <button type="button" class="chip-btn" data-minutes="90">90 мин (+5 000 ₽)</button>
              <button type="button" class="chip-btn" data-minutes="120">120 мин (+10 000 ₽)</button>
              <button type="button" class="chip-btn" data-minutes="150">150 мин (+15 000 ₽)</button>
              <button type="button" class="chip-btn" data-minutes="180">180 мин (+20 000 ₽)</button>
              <button type="button" class="chip-btn" data-minutes="240">240 мин (+30 000 ₽)</button>
            </div>
          </div>
        </div>

        <!-- 4. Дополнительные услуги (Опции) -->
        <div class="control-block">
          <div class="block-header">
            <span class="block-num">04</span>
            <label class="block-title">Дополнительные опции</label>
          </div>

          <div class="addons-grid">
            <!-- Нарезка Reels -->
            <div class="addon-item">
              <div class="addon-info">
                <span class="addon-title">Нарезки Reels / Shorts</span>
                <span class="addon-price">1 500 ₽ / шт</span>
              </div>
              <div class="counter-control">
                <button type="button" class="counter-btn" data-counter="reels" data-dir="-1" aria-label="Меньше">−</button>
                <span class="counter-val" id="reelsVal">0</span>
                <button type="button" class="counter-btn" data-counter="reels" data-dir="1" aria-label="Больше">+</button>
              </div>
            </div>

            <!-- Обложки Reels -->
            <div class="addon-item">
              <div class="addon-info">
                <span class="addon-title">Обложки для Reels</span>
                <span class="addon-price">1 000 ₽ / шт</span>
              </div>
              <div class="counter-control">
                <button type="button" class="counter-btn" data-counter="reelsCover" data-dir="-1" aria-label="Меньше">−</button>
                <span class="counter-val" id="reelsCoverVal">0</span>
                <button type="button" class="counter-btn" data-counter="reelsCover" data-dir="1" aria-label="Больше">+</button>
              </div>
            </div>

            <!-- Обложка выпуска YouTube -->
            <div class="addon-item">
              <div class="addon-info">
                <span class="addon-title">Обложка выпуска (YouTube)</span>
                <span class="addon-price">1 800 ₽ / шт</span>
              </div>
              <div class="counter-control">
                <button type="button" class="counter-btn" data-counter="videoCover" data-dir="-1" aria-label="Меньше">−</button>
                <span class="counter-val" id="videoCoverVal">0</span>
                <button type="button" class="counter-btn" data-counter="videoCover" data-dir="1" aria-label="Больше">+</button>
              </div>
            </div>

            <!-- Видеотизер -->
            <div class="addon-item">
              <div class="addon-info">
                <span class="addon-title">Динамичный видеотизер</span>
                <span class="addon-price">2 000 ₽ / шт</span>
              </div>
              <div class="counter-control">
                <button type="button" class="counter-btn" data-counter="teaser" data-dir="-1" aria-label="Меньше">−</button>
                <span class="counter-val" id="teaserVal">0</span>
                <button type="button" class="counter-btn" data-counter="teaser" data-dir="1" aria-label="Больше">+</button>
              </div>
            </div>

            <!-- Гримёр -->
            <div class="addon-item">
              <div class="addon-info">
                <span class="addon-title">Гримёр перед записью</span>
                <span class="addon-price">1 700 ₽ / образ</span>
              </div>
              <div class="counter-control">
                <button type="button" class="counter-btn" data-counter="makeup" data-dir="-1" aria-label="Меньше">−</button>
                <span class="counter-val" id="makeupVal">0</span>
                <button type="button" class="counter-btn" data-counter="makeup" data-dir="1" aria-label="Больше">+</button>
              </div>
            </div>

            <!-- Бэкстейдж -->
            <div class="addon-item">
              <div class="addon-info">
                <span class="addon-title">Фото / видео бэкстейдж</span>
                <span class="addon-price">2 500 ₽ / сет</span>
              </div>
              <div class="counter-control">
                <button type="button" class="counter-btn" data-counter="backstage" data-dir="-1" aria-label="Меньше">−</button>
                <span class="counter-val" id="backstageVal">0</span>
                <button type="button" class="counter-btn" data-counter="backstage" data-dir="1" aria-label="Больше">+</button>
              </div>
            </div>

            <!-- Телесуфлёр (Toggle) -->
            <div class="addon-item addon-item--toggle">
              <div class="addon-info">
                <span class="addon-title">Телесуфлёр на запись</span>
                <span class="addon-price">800 ₽ на всю запись</span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="togglePrompter" />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <!-- Расшифровка (Toggle) -->
            <div class="addon-item addon-item--toggle">
              <div class="addon-info">
                <span class="addon-title">Расшифровка выпуска (текст)</span>
                <span class="addon-price">4 200 ₽ за выпуск</span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggleTranscription" />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <!-- Ведущий (Toggle) -->
            <div class="addon-item addon-item--toggle">
              <div class="addon-info">
                <span class="addon-title">Профессиональный ведущий</span>
                <span class="addon-price">10 000 ₽ на 2 часа</span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggleHost" />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <!-- Публикация на площадках (Select) -->
            <div class="addon-item addon-item--select">
              <div class="addon-info">
                <span class="addon-title">Публикация на площадках</span>
                <span class="addon-price">Apple, Яндекс, YouTube, VK</span>
              </div>
              <select id="publishingSelect" class="form-select-styled form-select-sm">
                <option value="none" selected>Нет</option>
                <option value="first">Первый выпуск (4 000 ₽)</option>
                <option value="next">Следующий выпуск (1 000 ₽)</option>
              </select>
            </div>

            <!-- Интро 2D -->
            <div class="addon-item addon-item--select">
              <div class="addon-info">
                <span class="addon-title">Интро 2D-анимация</span>
                <span class="addon-price">1 000 ₽ / секунда</span>
              </div>
              <select id="intro2dSelect" class="form-select-styled form-select-sm">
                <option value="0" selected>Нет</option>
                <option value="5">5 секунд (5 000 ₽)</option>
                <option value="10">10 секунд (10 000 ₽)</option>
                <option value="15">15 секунд (15 000 ₽)</option>
                <option value="20">20 секунд (20 000 ₽)</option>
                <option value="30">30 секунд (30 000 ₽)</option>
              </select>
            </div>

            <!-- Интро 3D -->
            <div class="addon-item addon-item--select">
              <div class="addon-info">
                <span class="addon-title">Интро 3D-графика</span>
                <span class="addon-price">2 000 ₽ / секунда</span>
              </div>
              <select id="intro3dSelect" class="form-select-styled form-select-sm">
                <option value="0" selected>Нет</option>
                <option value="5">5 секунд (10 000 ₽)</option>
                <option value="10">10 секунд (20 000 ₽)</option>
                <option value="15">15 секунд (30 000 ₽)</option>
                <option value="20">20 секунд (40 000 ₽)</option>
                <option value="30">30 секунд (60 000 ₽)</option>
              </select>
            </div>
          </div>
        </div>

      </div>

      <!-- ПРАВАЯ КОЛОНКА: ДЕТАЛИЗИРОВАННАЯ СМЕТА (RECEIPT) -->
      <div class="calc-sidebar">
        <div class="receipt-card">
          <div class="receipt-top">
            <div class="receipt-badge">ХВАЛИТЕ QUALITY · СМЕТА</div>
            <button type="button" class="btn-reset" id="resetCalcBtn" title="Сбросить все параметры">
              <span class="reset-icon">↺</span>
              <span>Сбросить</span>
            </button>
          </div>

          <h3 class="receipt-title">Ваш расчёт заказа</h3>
          <p class="receipt-subtitle">Точная калькуляция на основе актуального прайс-листа студии</p>

          <!-- Список позиций в смете -->
          <div class="receipt-items-wrap">
            <div class="receipt-items-list" id="receiptItemsList">
              <!-- Заполняется динамически скриптом -->
            </div>
          </div>

          <!-- Финансовые итоги -->
          <div class="receipt-totals">
            <div class="grand-total-block">
              <div class="grand-total-header">
                <span class="grand-total-label">ИТОГО К ОПЛАТЕ:</span>
              </div>
              <div class="grand-total-price" id="finalTotalVal">11 500 ₽</div>
            </div>
          </div>

          <!-- Кнопки действий -->
          <div class="receipt-actions">
            <button
              type="button"
              class="btn-brutal btn-gold receipt-book-btn"
              id="bookCalcBtn"
              data-open-booking
              data-service-name="Калькулятор: индивидуальный заказ"
            >
              <span>Забронировать по этой смете</span>
              <span class="btn-arrow">→</span>
            </button>

            <button type="button" class="btn-copy-calc" id="copyCalcBtn">
              <span class="copy-icon">📋</span>
              <span class="copy-text">Скопировать смету текстом</span>
            </button>
          </div>

          <div class="receipt-footer-note">
            <span>⚡ Бронь студии закрепляется после подтверждения продюсером</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .calc-section {
    padding: 80px 0;
    border-top: 2px solid var(--color-dark);
    background: var(--color-bg);
    position: relative;
  }
  .section-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    margin-bottom: 45px;
  }
  .section-tag {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-stone);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .tag-star { color: var(--color-gold-bright); }
  .section-title {
    font-family: var(--font-accent);
    font-size: 32px;
    font-weight: 900;
    color: var(--color-dark);
    letter-spacing: -0.02em;
  }
  @media (min-width: 768px) {
    .section-title { font-size: 46px; }
  }
  .section-subtitle {
    font-size: 16px;
    color: var(--color-stone);
    max-width: 640px;
    line-height: 1.5;
  }

  /* Layout */
  .calc-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .calc-layout {
      grid-template-columns: 1fr 420px;
      gap: 36px;
    }
  }

  /* Blocks */
  .calc-controls {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .control-block {
    background: #FFFFFF;
    border: var(--border-dark);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-brutal);
    padding: 24px;
    transition: box-shadow 0.2s ease;
  }
  .control-block:hover {
    box-shadow: var(--shadow-brutal-hover);
  }
  .block-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 2px dashed #E5E4DF;
  }
  .block-num {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 800;
    background: var(--color-dark);
    color: var(--color-gold-bright);
    padding: 3px 8px;
    border-radius: var(--radius-pill);
  }
  .block-title {
    font-family: var(--font-accent);
    font-size: 18px;
    font-weight: 800;
    color: var(--color-dark);
  }
  .block-subtag {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-stone);
    text-transform: uppercase;
  }

  /* Service Cards */
  .service-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  @media (min-width: 580px) {
    .service-cards { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 768px) {
    .service-cards { grid-template-columns: repeat(3, 1fr); }
  }
  .service-card {
    text-align: left;
    background: #FAF9F5;
    border: 2px solid var(--color-dark);
    border-radius: var(--radius-sm);
    padding: 14px;
    cursor: pointer;
    box-shadow: 2px 2px 0px var(--color-dark);
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: all 0.15s ease;
  }
  .service-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0px var(--color-dark);
    background: #FFFFFF;
  }
  .service-card.is-active {
    background: var(--color-gold-bright);
    border-color: var(--color-dark);
    box-shadow: 3px 3px 0px var(--color-dark);
    transform: translate(-1px, -1px);
