    fieldDelivery: number;
    audio: Record<number, number>;
    stream: Record<number, Record<number, number>>;
    rental: Record<string, number>;
    editing: {
      simple: Record<number, number>;
      complex: Record<number, number>;
      extraPer30Min: number;
    };
    addons: {
      reels: number;
      reelsCover: number;
      videoCover: number;
      teaser: number;
      publishingFirst: number;
      publishingNext: number;
      transcription: number;
      prompter: number;
      host: number;
      makeup: number;
      intro2d: number;
      intro3d: number;
      backstage: number;
    };
  }

  interface CalculatorState {
