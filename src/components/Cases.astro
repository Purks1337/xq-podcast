---
// Cases.astro — Снято у нас / Кейсы студии ХВАЛИТЕ QUALITY
import { getAssetUrl } from '../utils/paths';

const rawCases = [
  {
    id: 'case-vk',
    title: 'Подкаст «MEDLIGA»',
    platform: 'VK Видео',
    platformClass: 'platform-vk',
    platformBadge: 'VK ВИДЕО',
    guest: 'Экспертный выпуск в студии',
    format: 'Мультикамерная съёмка 4K · Звук',
    views: 'VK Видео',
    img: '/assets/cases/case-vk.png',
    videoUrl: 'https://vkvideo.ru/video-208497865_456240560',
    embedUrl: 'https://vkvideo.ru/video_ext.php?oid=-208497865&id=456240560&hd=2&autoplay=1'
  },
  {
    id: 'case-rutube',
    title: 'Подкаст на Rutube',
    platform: 'Rutube',
    platformClass: 'platform-rutube',
    platformBadge: 'RUTUBE',
    guest: 'Студийный диалог · Ч/Б сетап',
    format: '3 камеры 4K · Цветокоррекция',
    views: 'Rutube',
    img: '/assets/cases/case-rutube.png',
    videoUrl: 'https://rutube.ru/video/7912d6f0161683e562daa0079dc52b3a/?r=wd',
    embedUrl: 'https://rutube.ru/play/embed/7912d6f0161683e562daa0079dc52b3a?autoStart=true'
  },
  {
    id: 'case-youtube',
    title: 'Подкаст «МЕЛЬНИЦА»',
    platform: 'YouTube',
    platformClass: 'platform-youtube',
    platformBadge: 'YOUTUBE',
    guest: 'В гостях: Алексей Тагс',
    format: '3 камеры 4K · Неоновый свет · Звук',
    views: 'YouTube',
    img: '/assets/cases/case-youtube.png',
    videoUrl: 'https://youtu.be/otKaLnODjro?si=5PXFeGGYfiyWplak',
    embedUrl: 'https://www.youtube-nocookie.com/embed/otKaLnODjro?autoplay=1'
  }
];

const cases = rawCases.map((c) => ({
  ...c,
  img: getAssetUrl(c.img)
}));
---

<section class="cases-section" id="cases">
  <div class="container">
    <div class="section-head">
      <div class="section-tag">
        <span>04 · ПОРТФОЛИО</span>
        <span class="tag-star">★</span>
      </div>
      <h2 class="section-title">Снято у нас</h2>
      <p class="section-subtitle">
        Выпуски и проекты, записанные и смонтированные в студии ХВАЛИТЕ QUALITY. Нажмите на карточку, чтобы посмотреть видео.
      </p>
    </div>

    <!-- Сетка кейсов: ровно 3 в ряд -->
    <div class="cases-grid">
      {cases.map((item) => (
        <article 
          class="case-card"
          data-case-card
          data-title={item.title}
          data-platform={item.platform}
          data-embed={item.embedUrl}
          data-url={item.videoUrl}
          tabindex="0"
          role="button"
          aria-label={`Смотреть ${item.title}`}
        >
          <div class="case-media">
            <img src={item.img} alt={item.title} class="case-img" loading="lazy" />
            <div class="case-play-badge">
              <span class="play-icon">▶</span>
            </div>
            <div class="case-top-badges">
              <span class={`badge-platform ${item.platformClass}`}>{item.platformBadge}</span>
            </div>
          </div>

          <div class="case-body">
            <div class="case-header-row">
              <span class="case-platform-name">{item.platform}</span>
              <span class="case-click-hint">Смотреть видео ↗</span>
            </div>
            <h3 class="case-title">{item.title}</h3>
            <p class="case-guest">{item.guest}</p>
            <div class="case-footer">
              <span class="case-format">{item.format}</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Кнопка по ТЗ: Смотреть другие кейсы -->
    <div class="cases-action">
      <a
        href="https://t.me/hvaliteq"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-brutal btn-white"
      >
        <span>Больше кейсов в нашем Telegram</span>
        <span>↗</span>
      </a>
    </div>
  </div>

  <!-- Модальное окно видеоплеера кейса -->
  <dialog id="caseVideoModal" class="case-video-modal" aria-label="Просмотр видео кейса">
    <div class="case-modal-card">
      <div class="case-modal-head">
        <div class="case-modal-title-group">
          <span class="case-modal-badge" id="modalPlatformBadge">ВИДЕО</span>
          <h3 class="case-modal-title" id="modalCaseTitle">Выпуск подкаста</h3>
        </div>
        <button type="button" class="case-modal-close" id="closeCaseVideoBtn" aria-label="Закрыть">✕</button>
      </div>

      <div class="case-modal-player-wrap">
        <iframe
          id="caseVideoIframe"
          src=""
          title="Плеер кейса"
          allow="autoplay; fullscreen; picture-in-picture; encrypted-media; gyroscope; accelerometer"
          frameborder="0"
          allowfullscreen
          class="case-video-iframe"
        ></iframe>
      </div>

      <div class="case-modal-foot">
        <a 
          id="modalExternalLink" 
          href="#" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-brutal btn-gold modal-ext-btn"
        >
          <span>Открыть на платформе</span>
          <span>↗</span>
        </a>
        <button type="button" class="btn-brutal btn-white modal-close-btn" id="modalCancelBtn">
          Закрыть
        </button>
      </div>
    </div>
  </dialog>
</section>

<style>
  .cases-section {
    padding: 70px 0;
    border-top: 2px solid var(--color-dark);
    background: var(--color-bg);
  }
  .section-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    margin-bottom: 40px;
  }
  .section-tag {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-stone);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .tag-star { color: var(--color-gold-bright); }
  .section-title {
    font-family: var(--font-accent);
    font-size: 36px;
    font-weight: 900;
    color: var(--color-dark);
  }
  @media (min-width: 768px) {
    .section-title { font-size: 48px; }
  }
  .section-subtitle {
    font-size: 16px;
    color: var(--color-stone);
    max-width: 600px;
  }
  .cases-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 40px;
  }
  @media (min-width: 768px) {
    .cases-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .case-card {
    background: #FFFFFF;
    border: var(--border-dark);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-brutal);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    text-align: left;
    outline: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .case-card:hover, .case-card:focus-visible {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-brutal-hover);
  }
  .case-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #1B1B1B;
  }
  .case-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .case-card:hover .case-img { transform: scale(1.05); }
  .case-play-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 52px;
    height: 52px;
    background: var(--color-gold-bright);
    border: 2px solid var(--color-dark);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 2px 2px 0px var(--color-dark);
    transition: transform 0.2s ease;
  }
  .case-card:hover .case-play-badge {
    transform: translate(-50%, -50%) scale(1.12);
  }
  .play-icon {
    font-size: 18px;
    color: var(--color-dark);
    margin-left: 3px;
  }
  .case-top-badges {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .badge-platform {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1.5px solid var(--color-dark);
    text-transform: uppercase;
  }
  .platform-vk {
    background: #0077FF;
    color: #FFFFFF;
  }
  .platform-rutube {
    background: #1F2229;
    color: #00E5FF;
  }
  .platform-youtube {
    background: #FF0000;
    color: #FFFFFF;
  }
  .case-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1 1 auto;
  }
  .case-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .case-platform-name {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--color-dark);
  }
  .case-click-hint {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-stone);
  }
  .case-card:hover .case-click-hint {
    color: var(--color-dark);
    text-decoration: underline;
  }
  .case-title {
    font-family: var(--font-accent);
    font-size: 18px;
    font-weight: 800;
    line-height: 1.3;
    color: var(--color-dark);
    margin: 0;
  }
  .case-guest {
    font-size: 14px;
    color: var(--color-stone);
    margin: 0 0 6px 0;
  }
  .case-footer {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px dashed rgba(27, 27, 27, 0.15);
  }
  .case-format {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-dark);
    background: #F1F0EC;
    padding: 3px 8px;
    border-radius: 4px;
    display: inline-block;
  }
  .cases-action {
    display: flex;
    justify-content: center;
  }

  /* Видеомодалка */
  .case-video-modal {
    border: none;
    background: transparent;
    padding: clamp(12px, 3vh, 24px);
    max-width: 860px;
    width: 100%;
    margin: auto;
  }
  .case-video-modal::backdrop {
    background: rgba(18, 18, 18, 0.85);
    backdrop-filter: blur(8px);
  }
  .case-modal-card {
    background: #FFFFFF;
    border: var(--border-dark);
    border-radius: var(--radius-card);
    box-shadow: 10px 10px 0px var(--color-dark);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .case-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: var(--color-dark);
    color: #FFFFFF;
  }
  .case-modal-title-group {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .case-modal-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    background: var(--color-gold-bright);
    color: var(--color-dark);
    padding: 2px 8px;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .case-modal-title {
    font-family: var(--font-accent);
    font-size: 16px;
    font-weight: 800;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .case-modal-close {
    background: transparent;
    border: 1.5px solid #FFFFFF;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 800;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }
  .case-modal-close:hover {
    background: #FFFFFF;
    color: var(--color-dark);
  }
  .case-modal-player-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000000;
  }
  .case-video-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
  .case-modal-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    background: #F7F6F2;
    border-top: 1.5px solid var(--color-dark);
  }
  .modal-ext-btn {
    padding: 10px 20px;
    font-size: 13px;
  }
  .modal-close-btn {
    padding: 10px 18px;
    font-size: 13px;
  }
</style>

<script>
  const videoModal = document.getElementById('caseVideoModal') as HTMLDialogElement | null;
  const videoIframe = document.getElementById('caseVideoIframe') as HTMLIFrameElement | null;
  const modalTitle = document.getElementById('modalCaseTitle');
  const modalBadge = document.getElementById('modalPlatformBadge');
  const modalExtLink = document.getElementById('modalExternalLink') as HTMLAnchorElement | null;
  const closeBtn = document.getElementById('closeCaseVideoBtn');
  const cancelBtn = document.getElementById('modalCancelBtn');
  const caseCards = document.querySelectorAll<HTMLElement>('[data-case-card]');

  function closeVideo() {
    if (!videoModal) return;
    if (videoIframe) videoIframe.src = '';
    videoModal.close();
  }

  caseCards.forEach((card) => {
    const openCard = () => {
      const embedUrl = card.dataset.embed || '';
      const videoUrl = card.dataset.url || '#';
      const title = card.dataset.title || '';
      const platform = card.dataset.platform || 'ВИДЕО';

      if (modalTitle) modalTitle.textContent = title;
      if (modalBadge) modalBadge.textContent = platform;
      if (modalExtLink) {
        modalExtLink.href = videoUrl;
        modalExtLink.querySelector('span')!.textContent = `Смотреть на ${platform}`;
      }
      if (videoIframe) {
        videoIframe.src = embedUrl;
      }
      videoModal?.showModal();
    };

    card.addEventListener('click', openCard);
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openCard();
      }
    });
  });

  closeBtn?.addEventListener('click', closeVideo);
  cancelBtn?.addEventListener('click', closeVideo);
  videoModal?.addEventListener('click', (e) => {
    if (e.target === videoModal) closeVideo();
  });
  videoModal?.addEventListener('cancel', closeVideo);
</script>
