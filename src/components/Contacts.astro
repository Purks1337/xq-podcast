</section>

<style>
  .contacts-section {
    padding: 70px 0 90px;
    border-top: 2px solid var(--color-dark);
    background: var(--color-bg);
  }
  .section-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    margin-bottom: 40px;
  }
  .section-tag {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-stone);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .tag-star { color: var(--color-gold-bright); }
  .section-title {
    font-family: var(--font-accent);
    font-size: 36px;
    font-weight: 900;
    color: var(--color-dark);
  }
  @media (min-width: 768px) {
    .section-title { font-size: 48px; }
  }
  .section-subtitle {
    font-size: 16px;
    color: var(--color-stone);
    max-width: 580px;
  }

  /* Фирменная карточка в стиле брендбука */
  .contacts-card {
    background: #FFFFFF;
    border: var(--border-dark-thick);
    border-radius: var(--radius-card-lg);
    box-shadow: var(--shadow-brutal-lg);
    overflow: hidden;
  }

  .contacts-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 960px) {
    .contacts-grid {
      grid-template-columns: 460px 1fr;
    }
  }

  .contacts-info {
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    background: #FAF9F5;
    border-bottom: 2px solid var(--color-dark);
  }

  @media (min-width: 960px) {
    .contacts-info {
      border-bottom: none;
      border-right: 2px solid var(--color-dark);
    }
  }

  .info-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .info-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-stone);
  }

  .address-main {
    font-family: var(--font-accent);
    font-size: 19px;
    font-weight: 800;
    color: var(--color-dark);
    line-height: 1.3;
  }

  .address-sub {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-stone);
    margin-top: 2px;
  }

  .route-action {
    display: flex;
  }

  .route-btn {
    padding: 14px 24px;
    font-size: 14px;
  }

  .social-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 10px;
    border-top: 1.5px dashed rgba(27, 27, 27, 0.18);
  }

  .social-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .social-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: #FFFFFF;
    border: 2px solid var(--color-dark);
    border-radius: var(--radius-pill);
    box-shadow: 2px 2px 0px var(--color-dark);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-dark);
    text-decoration: none;
    transition: transform 0.2s, background-color 0.2s, box-shadow 0.2s;
  }

  .social-badge:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0px var(--color-dark);
    background: var(--color-gold-light);
  }

  .contacts-direct {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    padding-top: 12px;
    border-top: 1.5px dashed rgba(27, 27, 27, 0.18);
  }

  .direct-link {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 800;
    color: var(--color-dark);
    text-decoration: none;
    transition: color 0.2s;
  }

  .direct-link--phone {
    font-size: 18px;
  }

  .direct-link:hover {
    color: var(--color-gold-bright);
  }

  /* Блок карты */
  .contacts-map-box {
    position: relative;
    min-height: 420px;
    background: #E5E4DF;
    display: flex;
    flex-direction: column;
    overflow: hidden; /* Обрезает баннер */
  }

  .map-tag {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    background: var(--color-dark);
    color: var(--color-gold-bright);
    border: 1.5px solid var(--color-dark);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 2px 2px 0px var(--color-dark);
  }

  .map-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-gold-bright);
  }

  .map-embed {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #E5E4DF;
  }

  .map-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: calc(100% + 110px);
    border: none;
    display: block;
  }

  @media (max-width: 640px) {
    .contacts-info {
      padding: 24px 20px;
    }
    .address-main {
      font-size: 16px;
    }
    .contacts-map-box {
      min-height: 300px;
    }
    .section-title {
      font-size: 26px;
    }
  }
</style>
