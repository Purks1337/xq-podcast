                  <path d="M1 5H4.76515C4.88882 11.4184 7.66459 14.1371 9.86321 14.6977V5H13.4085V10.5355C15.5796 10.2973 17.8607 7.77477 18.6302 5H22.1755C21.5846 8.41942 19.1112 10.9419 17.3523 11.979C19.1112 12.8198 21.9282 15.02 23 19H19.0974C18.2592 16.3373 16.1705 14.2773 13.4085 13.997V19H12.9825C5.46596 19 1.17864 13.7447 1 5Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"/>
