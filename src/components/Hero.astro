---
// Hero.astro — Хвалите Quality Студия подкастов
---

<section class="hero-section" id="hero">
  <div class="container">
    <div class="hero-grid">
      <!-- Левая колонка: Заголовок, Логотип, Описание, Кнопки -->
      <div class="hero-content">
        <!-- Заголовок в 2 строки на шрифте Unbounded -->

        <!-- 2. Заголовок в 2 строки на шрифте Unbounded -->
        <h1 class="hero-title">
          <span class="hero-title__line">Студия подкастов</span>
          <span class="hero-title__line hero-title__line--accent">в Екатеринбурге</span>
        </h1>

        <p class="hero-lead">
          Съемка на 3 камеры в 4K, студийный свет и звукорежиссёр на площадке. 
          Вы приходите и говорите — остальное делаем мы. 
          <span class="hero-lead-highlight">Готовый выпуск за 2 рабочих дня.</span>
        </p>

        <!-- 3. Кнопки: Записать подкаст и Позвонить -->
        <div class="hero-actions">
          <button type="button" class="btn-brutal btn-gold hero-btn-cta" data-open-booking>
            <span class="btn-icon-wrapper">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                <line x1="12" x2="12" y1="19" y2="22"/>
              </svg>
            </span>
            <span>Записать подкаст</span>
          </button>

          <a href="tel:+79923410520" class="btn-brutal btn-white hero-btn-call">
            <span class="btn-icon-wrapper">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </span>
            <span>Позвонить</span>
          </a>
        </div>

        <!-- Мини-плашки УТП -->
        <div class="hero-usp-row">
          <div class="hero-usp-item">
            <span class="usp-bullet">★</span>
            <span class="usp-text">2 съёмочные локации</span>
          </div>
          <div class="hero-usp-item">
            <span class="usp-bullet">★</span>
            <span class="usp-text">20+ вариантов интерьеров</span>
          </div>
          <div class="hero-usp-item">
            <span class="usp-bullet">★</span>
            <span class="usp-text">Команда на площадке</span>
          </div>
        </div>
      </div>

      <!-- Правая колонка: Брутальный постер-карточка в стиле ref/service -->
      <div class="hero-visual">
        <div class="hero-card-poster">
          <!-- Верхняя техническая полоса постера -->
          <div class="poster-tech-header">
            <div class="rec-status">
              <span class="rec-dot"></span>
              <span class="rec-label">REC 4K UHD</span>
            </div>
            <div class="cam-indicator">3x CAM · 60 FPS</div>
          </div>

          <!-- Главное видео локации студии -->
          <div class="poster-image-box">
            <!-- Фоновое видео Kinescope -->
            <div class="poster-video-wrap">
              <iframe
                id="hero-kinescope-video"
                src="https://kinescope.io/embed/pxwo5ksSHJKq9wNUP3vzQn?autoplay=1&muted=1&loop=1&controls=0&playsinline=1"
                title="Студия подкастов Хвалите Quality"
                allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
                allowfullscreen
                class="poster-video-iframe"
              ></iframe>
            </div>

            <!-- Заглушка с фото, помехами и лоадером до старта видео -->
            <div class="poster-placeholder" id="hero-placeholder">
              <img
                src="/assets/photos/lounge/DSC02584.jpg"
                alt="Студия подкастов Хвалите Quality"
                class="placeholder-photo"
              />
              <div class="tv-noise-layer"></div>
              <div class="tv-scanlines-layer"></div>
              <div class="tv-scanbeam"></div>

              <div class="poster-loader">
                <div class="loader-spin-ring">
                  <span class="loader-dot"></span>
                </div>
                <div class="loader-details">
                  <span class="loader-label">ПОДКЛЮЧЕНИЕ К ПОТОКУ</span>
                  <span class="loader-status">SIGNAL SYNC · 4K UHD</span>
                </div>
              </div>
            </div>

            <!-- Плавающий бейдж с гарантией срока -->
            <div class="sticker-badge sticker-badge--days">
              <div class="sticker-num">2</div>
              <div class="sticker-text">
                <strong>РАБОЧИХ ДНЯ</strong>
                <span>ДО ГОТОВОГО ВЫПУСКА</span>
              </div>
            </div>

            <!-- Плавающий бейдж локаций -->
            <div class="sticker-badge sticker-badge--location">
              <span class="sticker-loc-pill">ЛАУНДЖ · РЕТРО-ТВ</span>
              <span class="sticker-loc-desc">ТРАНСФОРМЕР · ГРИНСКРИН</span>
            </div>
          </div>

          <!-- Нижняя плашка карточки -->
          <div class="poster-footer">
            <div class="poster-footer__quote">
              <span class="quote-sign">“</span>
              <p>Вы приходите и говорите — остальное делаем мы</p>
            </div>
            <div class="poster-footer__badge">
              <span>HQ STUDIO</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 40px 0 60px;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 992px) {
    .hero-section {
      padding: 64px 0 88px;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 992px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 56px;
    }
  }

  /* Левая колонка */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }



  /* Заголовок в 2 строки на Unbounded */
  .hero-title {
    font-family: var(--font-accent);
    font-size: 34px;
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--color-dark);
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 46px;
    }
  }

  @media (min-width: 1200px) {
    .hero-title {
      font-size: 56px;
    }
  }

  .hero-title__line--accent {
    color: var(--color-dark);
    position: relative;
    display: inline-block;
  }

  .hero-lead {
    font-size: 17px;
    line-height: 1.55;
    color: #333333;
    max-width: 620px;
  }

  @media (min-width: 768px) {
    .hero-lead {
      font-size: 19px;
    }
  }

  .hero-lead-highlight {
    font-weight: 700;
    color: var(--color-dark);
    background: linear-gradient(180deg, transparent 65%, var(--color-gold-light) 65%);
    display: inline;
    padding: 0 4px;
  }

  /* Кнопки */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 6px;
  }

  .hero-btn-cta {
    padding: 16px 32px;
    font-size: 16px;
  }

  .hero-btn-call {
    padding: 16px 28px;
    font-size: 16px;
  }

  .btn-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* УТП плашки */
  .hero-usp-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 12px;
    padding-top: 20px;
    border-top: 2px dashed rgba(27, 27, 27, 0.18);
  }

  .hero-usp-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-stone);
    text-transform: uppercase;
  }

  .usp-bullet {
    color: var(--color-gold-bright);
    font-size: 14px;
  }

  /* Правая колонка — Брутальный постер */
  .hero-visual {
    position: relative;
  }

  .hero-card-poster {
    background: var(--color-card);
    border: var(--border-dark-thick);
    border-radius: var(--radius-card-lg);
    box-shadow: var(--shadow-brutal-lg);
    overflow: hidden;
    position: relative;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .hero-card-poster:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0px var(--color-dark);
  }

  .poster-tech-header {
    background: var(--color-dark);
    color: var(--color-white);
    padding: 10px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .rec-status {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rec-dot {
    width: 10px;
    height: 10px;
    background-color: var(--color-rec);
    border-radius: 50%;
    animation: recPulse 1.5s infinite;
  }

  @keyframes recPulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.85);
    }
  }

  .cam-indicator {
    color: var(--color-gold-bright);
    text-transform: uppercase;
  }

  .poster-image-box {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #222;
  }

  .poster-video-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #111 url('/assets/photos/lounge/DSC02584.jpg') center/cover no-repeat;
  }

  .poster-video-iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    /* 16:9 видео заполняет 4:3 окно ровно по высоте с центрированной обрезкой по бокам */
    width: calc(100% * (4 / 3) + 4px);
    height: 100%;
    transform: translate(-50%, -50%);
    border: none;
    pointer-events: none;
  }

  /* Заглушка с фото, помехами и лоадером */
  .poster-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111;
    transition: opacity 0.65s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.65s ease;
  }

  .poster-placeholder.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .placeholder-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.1) brightness(0.85) saturate(1.1);
  }

  /* Слой шума / статических помех */
  .tv-noise-layer {
    position: absolute;
    inset: -20px;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.35'/%3E%3C/svg%3E");
    background-repeat: repeat;
    opacity: 0.55;
    mix-blend-mode: overlay;
    pointer-events: none;
    animation: tvStaticShift 0.2s steps(2) infinite;
  }

  @keyframes tvStaticShift {
    0% { transform: translate(0, 0); }
    50% { transform: translate(-3px, 2px); }
    100% { transform: translate(2px, -3px); }
  }

  /* Горизонтальные телевизионные сканлайны (CRT строки) */
  .tv-scanlines-layer {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4) 0px,
      rgba(0, 0, 0, 0.4) 1px,
      transparent 1px,
      transparent 3px
    );
    opacity: 0.75;
    pointer-events: none;
  }

  /* Пробегающая полоса синхронизации/помех */
  .tv-scanbeam {
    position: absolute;
    left: 0;
    right: 0;
    height: 25%;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(255, 255, 255, 0.08) 50%,
      rgba(255, 204, 0, 0.15) 85%,
      transparent 100%
    );
    mix-blend-mode: screen;
    pointer-events: none;
    animation: scanbeamRoll 4s linear infinite;
  }

  @keyframes scanbeamRoll {
    0% { top: -30%; }
    100% { top: 130%; }
  }

  /* Брутальный лоадер подключения потока */
  .poster-loader {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    background: rgba(18, 18, 18, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 2px solid var(--color-dark);
    border-radius: 10px;
    box-shadow: 4px 4px 0px var(--color-dark);
  }

  .loader-spin-ring {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-top-color: var(--color-gold-bright);
    border-right-color: var(--color-gold-bright);
    border-radius: 50%;
    animation: loaderSpin 0.8s linear infinite;
    position: relative;
    flex-shrink: 0;
  }

  @keyframes loaderSpin {
    to { transform: rotate(360deg); }
  }

  .loader-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .loader-label {
    font-family: var(--font-accent);
    font-size: 11px;
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: 0.05em;
    line-height: 1.2;
  }

  .loader-status {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    color: var(--color-gold-bright);
    letter-spacing: 0.08em;
  }

  /* Стикеры */
  .sticker-badge {
    position: absolute;
    border: 2px solid var(--color-dark);
    border-radius: 12px;
    box-shadow: var(--shadow-brutal);
    z-index: 2;
  }

  .sticker-badge--days {
    bottom: 16px;
    left: 16px;
    background: var(--color-gold-bright);
    color: var(--color-dark);
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .sticker-num {
    font-family: var(--font-accent);
    font-size: 32px;
    font-weight: 900;
    line-height: 1;
  }

  .sticker-text {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.25;
  }

  .sticker-text strong {
    font-weight: 900;
    letter-spacing: 0.06em;
  }

  .sticker-text span {
    font-size: 10px;
    opacity: 0.85;
  }

  .sticker-badge--location {
    top: 16px;
    right: 16px;
    background: var(--color-white);
    color: var(--color-dark);
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-mono);
  }

  .sticker-loc-pill {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .sticker-loc-desc {
    font-size: 9px;
    color: var(--color-stone);
    font-weight: 600;
  }

  /* Футер постера */
  .poster-footer {
    padding: 16px 20px;
    background: var(--color-card-warm);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: 2px solid var(--color-dark);
  }

  .poster-footer__quote {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-text);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-dark);
  }

  .quote-sign {
    color: var(--color-gold-bright);
    font-family: var(--font-accent);
    font-size: 20px;
    font-weight: 900;
  }

  .poster-footer__badge {
    background: var(--color-dark);
    color: var(--color-gold-bright);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
</style>

<script>
  function initHeroVideoSync() {
    const placeholder = document.getElementById('hero-placeholder');
    const iframe = document.getElementById('hero-kinescope-video') as HTMLIFrameElement | null;

    if (!placeholder || !iframe) return;

    let isRevealed = false;
    const revealVideo = () => {
      if (isRevealed) return;
      isRevealed = true;
      placeholder.classList.add('is-hidden');
    };

    // Слушаем событие завершения базовой загрузки iframe
    iframe.addEventListener('load', () => {
      // 800мс буфер, чтобы плеер Kinescope успел запустить первый кадр потока
      setTimeout(revealVideo, 800);
    });

    // Слушаем postMessage-события от плеера Kinescope
    window.addEventListener('message', (event) => {
      try {
        const payload = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
        if (payload) {
          const evt = payload.event || payload.type;
          if (evt === 'playing' || evt === 'timeupdate' || evt === 'ready') {
            revealVideo();
          }
        }
      } catch (_) {}
    });

    // Страховочный таймаут: при медленном соединении показываем плеер максимум через 3.5 сек
    setTimeout(revealVideo, 3500);
  }

  // Запуск при старте и поддержке навигации
  initHeroVideoSync();
  document.addEventListener('astro:page-load', initHeroVideoSync);
</script>
