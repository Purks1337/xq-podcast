---
// PhotoGallery.astro — Карусель студий с полноэкранным просмотром
import "../styles/gallery.css";
import Lightbox from "./Lightbox.astro";

const locations = [
  {
    id: "transformer",
    title: "Локация трансформер",
    desc: "Более 20 вариантов фоновых решений: от классических текстур до цифровых миров через встроенный гринскрин.",
    badge: "20+ СЕТАПОВ",
    photos: [
      { src: "/assets/photos/transformer/DSC02489.jpg", title: "Сетап Dark Minimal — контрастный теневой свет" },
      { src: "/assets/photos/transformer/DSC02497.jpg", title: "Премиальные кресла и настроенный свет" },
      { src: "/assets/photos/transformer/DSC02498.jpg", title: "Рабочая зона ведущих подкаста" },
      { src: "/assets/photos/transformer/DSC02501.jpg", title: "Гринскрин и фоновые конструкции" },
      { src: "/assets/photos/transformer/DSC02502.jpg", title: "Вид на студийный сетап" },
      { src: "/assets/photos/transformer/DSC02510.jpg", title: "Позиционирование камер и микрофонов" },
      { src: "/assets/photos/transformer/DSC02517.jpg", title: "3 камеры 4K в боевой готовности" },
      { src: "/assets/photos/transformer/DSC02521.jpg", title: "Звукоизоляция и акустическая подготовка" },
      { src: "/assets/photos/transformer/DSC02526.jpg", title: "Премиальный звук Shure и мониторы" },
      { src: "/assets/photos/transformer/DSC02535.jpg", title: "Мягкий рассеянный контровой свет" },
      { src: "/assets/photos/transformer/DSC02542.jpg", title: "Контрастный кинематографичный рисунок" },
      { src: "/assets/photos/transformer/DSC02550.jpg", title: "Общий вид трансформируемой локации" },
      { src: "/assets/photos/transformer/DSC02554.jpg", title: "Зона для съёмки интервью и диалогов" },
      { src: "/assets/photos/transformer/DSC02573.jpg", title: "Готовый кадр для записи выпуска" }
    ]
  },
  {
    id: "lounge",
    title: "Локация лаундж",
    desc: "Антуражная локация, окруженная растениями, вокруг 5 ретро телевизоров, можно вывести любое изображение или видео.",
    badge: "5 РЕТРО-ТВ",
    photos: [
      { src: "/assets/photos/lounge/DSC02584.jpg", title: "Ретро-ТВ и живые тропические растения" },
      { src: "/assets/photos/lounge/DSC02577.jpg", title: "Уютные кожаные кресла и тёплый ламповый свет" },
      { src: "/assets/photos/lounge/DSC02587.jpg", title: "Кастомный видеоряд на экранах телевизоров" },
      { src: "/assets/photos/lounge/DSC02589.jpg", title: "Общий план лаундж-студии" },
      { src: "/assets/photos/lounge/DSC02591.jpg", title: "Атмосферный тёплый сетап для беседы" },
      { src: "/assets/photos/lounge/DSC02596.jpg", title: "Премиальные микрофоны и звукопоглощение" }
    ]
  }
];
---

<section class="gallery-section" id="photos">
  <div class="container">
    <div class="section-head">
      <div class="section-tag">
        <span>02 · ЛОКАЦИИ</span>
        <span class="tag-star">★</span>
      </div>
      <h2 class="section-title">Фото студии</h2>
      <p class="section-subtitle">
        Два принципиально разных съёмочных пространства под любые задачи вашего подкаста
      </p>

      <div class="gallery-tabs-wrap">
        <div class="location-tabs" role="tablist">
          <button
            type="button"
            class="tab-btn is-active"
            data-target="transformer"
            role="tab"
            aria-selected="true"
          >
            <span>Локация трансформер</span>
            <span class="tab-badge">20+ фонов</span>
          </button>
          <button
            type="button"
            class="tab-btn"
            data-target="lounge"
            role="tab"
            aria-selected="false"
          >
            <span>Локация лаундж</span>
            <span class="tab-badge">5 ретро-ТВ</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Панели студий с каруселями -->
    <div class="locations-content">
      {locations.map((loc, locIdx) => (
        <div
          class={"studio-panel " + (locIdx === 0 ? "is-active" : "")}
          id={"loc-" + loc.id}
          data-panel={loc.id}
          role="tabpanel"
        >
          <!-- Карточка описания студии -->
          <div class="studio-header">
            <div class="studio-header__left">
              <span class="studio-badge">{loc.badge}</span>
              <h3 class="studio-title">{loc.title}</h3>
            </div>
            <p class="studio-desc">{loc.desc}</p>
          </div>

          <!-- Карусель студии -->
          <div class="studio-carousel" data-carousel={loc.id} data-photos={JSON.stringify(loc.photos)}>
            <!-- Главное большое фото во всю ширину -->
            <div class="carousel-main" title="Нажмите для открытия на весь экран">
              <img
                src={loc.photos[0].src}
                alt={loc.photos[0].title}
                class="carousel-main__img"
                loading="eager"
              />
              <div class="carousel-main__gradient"></div>

              <!-- Стрелка назад -->
              <button type="button" class="carousel-arrow carousel-arrow--prev" aria-label="Предыдущее фото">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>

              <!-- Стрелка вперед -->
              <button type="button" class="carousel-arrow carousel-arrow--next" aria-label="Следующее фото">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>

              <!-- Счетчик -->
              <div class="carousel-counter">
                <span class="c-curr">01</span> / <span class="c-total">{String(loc.photos.length).padStart(2, "0")}</span>
              </div>

              <!-- Нижняя плашка с описанием и кнопкой Fullscreen -->
              <div class="carousel-main__meta">
                <div class="carousel-main__caption">{loc.photos[0].title}</div>
                <button type="button" class="carousel-main__zoom-btn">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <polyline points="9 21 3 21 3 15"></polyline>
                    <line x1="21" y1="3" x2="14" y2="10"></line>
                    <line x1="3" y1="21" x2="10" y2="14"></line>
                  </svg>
                  <span>На весь экран</span>
                </button>
              </div>
            </div>

            <!-- Лента миниатюр снизу -->
            <div class="carousel-thumbs" role="tablist" aria-label="Миниатюры фотографий">
              {loc.photos.map((photo, pIdx) => (
                <button
                  type="button"
                  class={"thumb-item " + (pIdx === 0 ? "is-active" : "")}
                  data-thumb-idx={pIdx}
                  title={photo.title}
                  aria-label={photo.title}
                >
                  <img src={photo.src} alt={photo.title} loading="lazy" />
                </button>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Модальный просмотрщик на весь экран -->
  <Lightbox />
</section>

<script>
  // 1. Переключение табов студий
  const tabBtns = document.querySelectorAll(".tab-btn");
  const panels = document.querySelectorAll(".studio-panel");

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetId = btn.getAttribute("data-target");

      tabBtns.forEach((b) => {
        b.classList.remove("is-active");
        b.setAttribute("aria-selected", "false");
      });
      btn.classList.add("is-active");
      btn.setAttribute("aria-selected", "true");

      panels.forEach((p) => {
        if (p.getAttribute("data-panel") === targetId) {
          p.classList.add("is-active");
        } else {
          p.classList.remove("is-active");
        }
      });
    });
  });

  // 2. Инициализация каждой карусели
  const carousels = document.querySelectorAll(".studio-carousel");

  carousels.forEach((carouselEl) => {
    const rawData = carouselEl.getAttribute("data-photos");
    if (!rawData) return;
    const photos: { src: string; title: string }[] = JSON.parse(rawData);
    let activeIdx = 0;

    const mainWrap = carouselEl.querySelector<HTMLElement>(".carousel-main");
    const mainImg = carouselEl.querySelector<HTMLImageElement>(".carousel-main__img");
    const captionEl = carouselEl.querySelector<HTMLElement>(".carousel-main__caption");
    const counterCurr = carouselEl.querySelector<HTMLElement>(".c-curr");
    const prevBtn = carouselEl.querySelector<HTMLElement>(".carousel-arrow--prev");
    const nextBtn = carouselEl.querySelector<HTMLElement>(".carousel-arrow--next");
    const zoomBtn = carouselEl.querySelector<HTMLElement>(".carousel-main__zoom-btn");
    const thumbs = carouselEl.querySelectorAll<HTMLElement>(".thumb-item");
    const thumbsStrip = carouselEl.querySelector<HTMLElement>(".carousel-thumbs");

    function updateSlide(newIdx: number) {
      if (newIdx < 0) newIdx = photos.length - 1;
      if (newIdx >= photos.length) newIdx = 0;
      activeIdx = newIdx;

      const p = photos[activeIdx];
      if (mainImg && p) {
        mainImg.style.opacity = "0.4";
        mainImg.src = p.src;
        mainImg.alt = p.title;
        mainImg.onload = () => {
          if (mainImg) mainImg.style.opacity = "1";
        };
      }
      if (captionEl && p) captionEl.textContent = p.title;
      if (counterCurr) counterCurr.textContent = String(activeIdx + 1).padStart(2, "0");

      thumbs.forEach((th, i) => {
        if (i === activeIdx) {
          th.classList.add("is-active");
          th.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
        } else {
          th.classList.remove("is-active");
        }
      });
    }

    // Клик по стрелкам
    prevBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      updateSlide(activeIdx - 1);
    });

    nextBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      updateSlide(activeIdx + 1);
    });

    // Клик по миниатюрам
    thumbs.forEach((thumb, tIdx) => {
      thumb.addEventListener("click", () => {
        updateSlide(tIdx);
      });
    });

    // Открытие на весь экран (при клике на фото или кнопку zoom)
    function triggerFullscreen(e: Event) {
      e.stopPropagation();
      if (typeof (window as any).openLightbox === "function") {
        (window as any).openLightbox(photos, activeIdx);
      }
    }

    mainWrap?.addEventListener("click", triggerFullscreen);
    zoomBtn?.addEventListener("click", triggerFullscreen);
  });
</script>
