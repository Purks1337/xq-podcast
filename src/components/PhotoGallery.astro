---
// PhotoGallery.astro — Локации студии ХВАЛИТЕ QUALITY
const locations = [
  {
    id: 'transformer',
    title: 'Локация трансформер',
    desc: 'Более 20 вариантов фоновых решений: от классических текстур до цифровых миров через встроенный гринскрин.',
    badge: '20+ СЕТАПОВ',
    photos: [
      { src: '/assets/photos/transformer/DSC02489.jpg', title: 'Сетап Dark Minimal' },
      { src: '/assets/photos/transformer/DSC02497.jpg', title: 'Студийный свет и кресла' },
      { src: '/assets/photos/transformer/DSC02501.jpg', title: 'Гринскрин и фоны' },
      { src: '/assets/photos/transformer/DSC02517.jpg', title: '3 камеры 4K в работе' },
      { src: '/assets/photos/transformer/DSC02526.jpg', title: 'Премиальный звук' },
      { src: '/assets/photos/transformer/DSC02542.jpg', title: 'Контрастный световой рисунок' },
    ]
  },
  {
    id: 'lounge',
    title: 'Локация лаундж',
    desc: 'Антуражная локация, окруженная растениями, вокруг 5 ретро телевизоров, можно вывести любое изображение или видео.',
    badge: '5 РЕТРО-ТВ',
    photos: [
      { src: '/assets/photos/lounge/DSC02584.jpg', title: 'Ретро-ТВ и живые растения' },
      { src: '/assets/photos/lounge/DSC02577.jpg', title: 'Уютные кожаные кресла' },
      { src: '/assets/photos/lounge/DSC02587.jpg', title: 'Кастомный видеоряд на экранах' },
      { src: '/assets/photos/lounge/DSC02589.jpg', title: 'Общий план студии' },
      { src: '/assets/photos/lounge/DSC02591.jpg', title: 'Ламповая тёплая атмосфера' },
      { src: '/assets/photos/lounge/DSC02596.jpg', title: 'Звуковая изоляция' },
    ]
  }
];
---

<section class="gallery-section" id="photos">
  <div class="container">
    <div class="section-head">
      <div class="section-tag">
        <span>02 · ЛОКАЦИИ</span>
        <span class="tag-star">★</span>
      </div>
      <h2 class="section-title">Фото студии</h2>
      <p class="section-subtitle">
        Два принципиально разных съёмочных пространства под любые задачи вашего подкаста
      </p>

      <!-- Табы переключения локаций -->
      <div class="location-tabs" role="tablist">
        <button
          type="button"
          class="tab-btn is-active"
          data-target="transformer"
          role="tab"
          aria-selected="true"
        >
          <span>Локация трансформер</span>
          <span class="tab-badge">20+ фонов</span>
        </button>
        <button
          type="button"
          class="tab-btn"
          data-target="lounge"
          role="tab"
          aria-selected="false"
        >
          <span>Локация лаундж</span>
          <span class="tab-badge">5 ретро-ТВ</span>
        </button>
      </div>
    </div>

    <!-- Контент локаций -->
    <div class="locations-content">
      {locations.map((loc, idx) => (
        <div
          class={`location-panel ${idx === 0 ? 'is-active' : ''}`}
          id={`loc-${loc.id}`}
          data-panel={loc.id}
          role="tabpanel"
        >
          <div class="loc-info-card">
            <div class="loc-info-left">
              <span class="loc-badge">{loc.badge}</span>
              <h3 class="loc-title">{loc.title}</h3>
            </div>
            <p class="loc-desc">{loc.desc}</p>
          </div>

          <!-- Сетка фото -->
          <div class="photo-grid">
            {loc.photos.map((photo, pIdx) => (
              <div class={`photo-card ${pIdx === 0 ? 'photo-card--featured' : ''}`}>
                <img
                  src={photo.src}
                  alt={photo.title}
                  class="photo-card__img"
                  loading="lazy"
                />
                <div class="photo-card__overlay">
                  <span class="photo-card__label">{photo.title}</span>
                  <span class="photo-card__zoom">🔍</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-section {
    padding: 70px 0;
    position: relative;
    border-top: 2px solid var(--color-dark);
    background-color: var(--color-bg);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 40px;
    gap: 12px;
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-stone);
    text-transform: uppercase;
  }

  .tag-star {
    color: var(--color-gold-bright);
  }

  .section-title {
    font-family: var(--font-accent);
    font-size: 36px;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--color-dark);
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: 48px;
    }
  }

  .section-subtitle {
    font-size: 16px;
    color: var(--color-stone);
    max-width: 600px;
    margin-bottom: 8px;
  }

  /* Табы */
  .location-tabs {
    display: inline-flex;
    background: #FFFFFF;
    padding: 6px;
    border: 2px solid var(--color-dark);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-brutal);
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 22px;
    font-family: var(--font-accent);
    font-size: 14px;
    font-weight: 700;
    border-radius: var(--radius-pill);
    border: 2px solid transparent;
    color: var(--color-dark);
    transition: all var(--transition-fast);
  }

  .tab-btn:hover {
    background: rgba(212, 165, 76, 0.15);
  }

  .tab-btn.is-active {
    background: var(--color-gold-bright);
    border-color: var(--color-dark);
    box-shadow: 2px 2px 0px var(--color-dark);
  }

  .tab-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 800;
    background: var(--color-dark);
    color: var(--color-white);
    padding: 2px 7px;
    border-radius: var(--radius-pill);
  }

  .tab-btn.is-active .tab-badge {
    background: var(--color-dark);
    color: var(--color-gold-bright);
  }

  /* Панели */
  .location-panel {
    display: none;
    animation: fadeIn 0.3s ease;
  }

  .location-panel.is-active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Карточка с описанием */
  .loc-info-card {
    background: #FFFFFF;
    border: var(--border-dark);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-brutal);
    padding: 24px 28px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  @media (min-width: 768px) {
    .loc-info-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
    }
  }

  .loc-info-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .loc-badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    color: var(--color-dark);
    background: var(--color-gold-light);
    border: 1.5px solid var(--color-dark);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .loc-title {
    font-family: var(--font-accent);
    font-size: 24px;
    font-weight: 800;
    color: var(--color-dark);
  }

  .loc-desc {
    font-size: 15px;
    line-height: 1.55;
    color: #333333;
    max-width: 580px;
  }

  /* Сетка фото */
  .photo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 600px) {
    .photo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .photo-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .photo-card--featured {
      grid-column: span 2;
    }
  }

  .photo-card {
    position: relative;
    border: var(--border-dark);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: #111;
    box-shadow: var(--shadow-brutal);
    aspect-ratio: 16 / 10;
    cursor: pointer;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .photo-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-brutal-hover);
  }

  .photo-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .photo-card:hover .photo-card__img {
    transform: scale(1.05);
  }

  .photo-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(27, 27, 27, 0.85) 100%);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 16px 20px;
    color: #FFFFFF;
  }

  .photo-card__label {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .photo-card__zoom {
    font-size: 16px;
    opacity: 0.8;
  }
</style>

<script>
  const tabBtns = document.querySelectorAll('.tab-btn');
  const panels = document.querySelectorAll('.location-panel');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');

      tabBtns.forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');

      panels.forEach((p) => {
        if (p.getAttribute('data-panel') === targetId) {
          p.classList.add('is-active');
        } else {
          p.classList.remove('is-active');
        }
      });
    });
  });
</script>
