---
import '../styles/global.css';
import { getAssetUrl } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ХВАЛИТЕ QUALITY — Студия подкастов в Екатеринбурге",
  description = "Профессиональная студия подкастов в Екатеринбурге: 3 камеры 4K, студийный свет, звукорежиссёр, 2 уникальные локации (трансформер и лаундж с ретро-ТВ). Готовый выпуск за 2 рабочих дня."
} = Astro.props;

const ogImage = new URL(getAssetUrl('/assets/photos/lounge/DSC02577.jpg'), Astro.site ?? 'https://Purks1337.github.io').href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={getAssetUrl('/assets/logo/star-monogram.svg')} />
    <link rel="apple-touch-icon" href={getAssetUrl('/assets/logo/star-monogram.svg')} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Unbounded, Golos Text, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700;800&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Unbounded:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content={ogImage} />
  </head>
  <body>


    <div class="page-wrapper">
      <slot />
    </div>

    <!-- Cookie Notice Banner -->
    <div id="cookie-banner" class="cookie-banner" role="region" aria-label="Уведомление о файлах cookie">
      <div class="cookie-header">
        <div class="cookie-tag">
          <span>🍪</span>
          <span>ФАЙЛЫ COOKIE</span>
        </div>
        <button type="button" id="cookie-close-btn" class="cookie-close-btn" aria-label="Закрыть уведомление">✕</button>
      </div>
      <div class="cookie-body">
        <p class="cookie-text">
          Мы используем cookie, чтобы сайт, калькулятор и видеоплееры работали стабильно и быстро. Подробнее — в <a href={getAssetUrl('/privacy/#cookies')} class="cookie-link">политике использования cookie</a>.
        </p>
        <div class="cookie-footer-row">
          <button type="button" id="cookie-accept-btn" class="btn-brutal btn-gold cookie-accept-btn">
            <span>Понятно</span>
          </button>
        </div>
      </div>
    </div>

    <script is:inline>
      (function() {
        try {
          var COOKIE_KEY = 'xq_podcast_cookie_ack_v1';
          var banner = document.getElementById('cookie-banner');
          if (banner) {
            if (!localStorage.getItem(COOKIE_KEY)) {
              banner.classList.add('is-visible');
            }
            var accept = function() {
              try { localStorage.setItem(COOKIE_KEY, '1'); } catch(e) {}
              banner.classList.remove('is-visible');
            };
            var btn = document.getElementById('cookie-accept-btn');
            if (btn) btn.onclick = accept;
            var closeBtn = document.getElementById('cookie-close-btn');
            if (closeBtn) closeBtn.onclick = accept;
          }
        } catch(e) {}
      })();
    </script>
  </body>
</html>

<style>


  .page-wrapper {
    position: relative;
    min-height: 100vh;
  }

  /* 🍪 Cookie Banner */
  .cookie-banner {
    position: fixed;
    bottom: 24px;
    right: 24px;
    left: auto;
    width: calc(100% - 48px);
    max-width: 440px;
    z-index: 99999;
    background: #FFFFFF;
    border: var(--border-dark);
    border-radius: var(--radius-card);
    box-shadow: 6px 6px 0px var(--color-dark);
    display: none;
    flex-direction: column;
    overflow: hidden;
  }

  .cookie-banner.is-visible {
    display: flex !important;
    animation: cookieFadeUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @media (max-width: 640px) {
    .cookie-banner {
      bottom: 16px;
      left: 16px;
      right: 16px;
      width: auto;
      max-width: none;
    }
  }

  @keyframes cookieFadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cookie-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: var(--color-dark);
    color: #FFFFFF;
  }

  .cookie-tag {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .cookie-close-btn {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid #FFFFFF;
    background: transparent;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    border-radius: 4px;
    transition: all var(--transition-fast);
  }

  .cookie-close-btn:hover {
    background: #FFFFFF;
    color: var(--color-dark);
  }

  .cookie-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cookie-text {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: #2D2D2D;
  }

  .cookie-link {
    color: var(--color-dark);
    font-weight: 700;
    text-decoration: underline;
  }

  .cookie-link:hover {
    color: var(--color-gold-bright);
  }

  .cookie-footer-row {
    display: flex;
    justify-content: flex-end;
  }

  .cookie-accept-btn {
    padding: 8px 22px;
    font-size: 13px;
    border-radius: var(--radius-btn);
  }
</style>
