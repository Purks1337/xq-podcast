---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ХВАЛИТЕ QUALITY — Студия подкастов в Екатеринбурге",
  description = "Профессиональная студия подкастов в Екатеринбурге: 3 камеры 4K, студийный свет, звукорежиссёр, 2 уникальные локации (трансформер и лаундж с ретро-ТВ). Готовый выпуск за 2 рабочих дня."
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo/star-monogram.svg" />
    <link rel="apple-touch-icon" href="/assets/logo/star-monogram.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Unbounded, Golos Text, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700;800&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Unbounded:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content="/assets/service/pod-klyuch-01.png" />
  </head>
  <body>
    <!-- Side brand strip (inspired by ref/service poster style) -->
    <aside class="side-strip" aria-hidden="true">
      <div class="side-strip__inner">
        <span class="side-strip__star">✦</span>
        <span class="side-strip__text">ВИДЕОПОДКАСТЫ — ХВАЛИТЕ QUALITY — ЕКАТЕРИНБУРГ</span>
        <span class="side-strip__badge">HQ</span>
      </div>
    </aside>

    <div class="page-wrapper">
      <slot />
    </div>
  </body>
</html>

<style>
  /* Side technical strip from the ref/service posters */
  .side-strip {
    display: none;
  }

  @media (min-width: 1280px) {
    .side-strip {
      display: flex;
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      width: 44px;
      background-color: var(--color-dark);
      z-index: 100;
      border-right: 1px solid rgba(255, 255, 255, 0.1);
      align-items: center;
      justify-content: center;
    }

    .side-strip__inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
      transform: rotate(-90deg);
      white-space: nowrap;
    }

    .side-strip__star {
      color: var(--color-gold-bright);
      font-size: 14px;
    }

    .side-strip__text {
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.16em;
      color: rgba(228, 227, 222, 0.7);
      text-transform: uppercase;
    }

    .side-strip__badge {
      font-family: var(--font-mono);
      font-size: 9px;
      font-weight: 800;
      background: var(--color-gold-bright);
      color: var(--color-dark);
      padding: 1px 6px;
      border-radius: 4px;
    }

    .page-wrapper {
      margin-left: 44px;
    }
  }

  .page-wrapper {
    position: relative;
    min-height: 100vh;
  }
</style>
